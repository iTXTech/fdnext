{
  "name": "@itxtech/fdnext-resources",
  "version": "2.3.0",
  "description": "Embedded fdnext FDB, MDB, PN suggestion, and language resources",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "resources/**/*.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTXTech/fdnext.git",
    "directory": "packages/resources"
  },
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/resources",
  "bugs": {
    "url": "https://github.com/iTXTech/fdnext/issues"
  },
  "keywords": [
    "fdnext",
    "flash",
    "nand",
    "database",
    "resources"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}