{
  "name": "@itxtech/fdnext-contract-test",
  "version": "3.2.0",
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/contract-test",
  "type": "module",
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*",
    "ajv": "^8.20.0"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b --emitDeclarationOnly",
    "prepare:packages": "pnpm -r --filter @itxtech/fdnext-core --filter @itxtech/fdnext-server --filter @itxtech/fdnext-cf-workers --filter @itxtech/fdnext-aliyun-fc build",
    "check": "pnpm prepare:packages && pnpm check:prepared",
    "check:prepared": "TSX_TSCONFIG_PATH=tsconfig.package-test.json tsx src/cli.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly",
    "test": "pnpm prepare:packages && pnpm test:prepared",
    "test:prepared": "TSX_TSCONFIG_PATH=tsconfig.package-test.json node --import tsx --test --test-isolation=none 'test/**/*.test.ts'",
    "test:part-search:dram": "pnpm prepare:packages && TSX_TSCONFIG_PATH=tsconfig.package-test.json node --import tsx --test test/sdk-part-search-dedup-dram.pn.ts"
  },
  "devDependencies": {
    "@itxtech/fdnext-aliyun-fc": "workspace:*",
    "@itxtech/fdnext-cf-workers": "workspace:*",
    "@itxtech/fdnext-server": "workspace:*"
  }
}
