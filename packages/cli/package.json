{
  "name": "@itxtech/fdnext-cli",
  "version": "2.3.0",
  "description": "Command-line interface for fdnext decoding, search, and DecodePack diagnostics",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fdnext": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTXTech/fdnext.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/cli",
  "bugs": {
    "url": "https://github.com/iTXTech/fdnext/issues"
  },
  "keywords": [
    "fdnext",
    "cli",
    "flash",
    "nand",
    "decodepack"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*",
    "@itxtech/fdnext-decodepack": "workspace:*",
    "@itxtech/fdnext-resources": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly",
    "test": "tsx test/decodepack.test.ts"
  }
}
