{
  "name": "@itxtech/fdnext-cli",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fdnext": "dist/index.js"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*",
    "@itxtech/fdnext-dsl": "workspace:*",
