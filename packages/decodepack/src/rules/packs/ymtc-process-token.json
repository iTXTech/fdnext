          "X3-9070": "X3-9070 / WDS",
          "X3-6070": "X3-6070 / EMS",
          "X4-9060": "X4-9060 / WT",
          "X4-9070": "X4-9070",
          "X4-6080": "X4-6080"
        },
        "cellLevel": {
          "X0-A030": 2,
          "X1-9050": 3,
          "X2-9060": 3,
          "X2-6070": 4,
          "X3-9060": 3,
          "X3-9070": 3,
          "X3-6070": 4,
          "X4-9060": 3,
          "X4-9070": 3,
          "X4-6080": 4
        },
        "generation": {
          "X0-A030": 1,
          "X1-9050": 2,
          "X2-9060": 3,
          "X2-6070": 3,
          "X3-9060": 4,
          "X3-9070": 4,
          "X3-6070": 4,
          "X4-9060": 5,
          "X4-9070": 5,
          "X4-6080": 5
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "processAlias",
          "to": "processKey",
          "default": ""
        },
        {
          "op": "map",
          "from": "processKey",
          "table": "processNode",
