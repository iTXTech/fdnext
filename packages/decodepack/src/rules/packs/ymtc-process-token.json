[
  {
    "id": "vendor.ymtc.process-alias.v1",
    "priority": 936,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          "."
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^X[0-9]-[0-9A-Z]+$"
    },
    "tokenDecoder": {
      "tables": {
        "processAlias": {
          "X0-A030": "X0-A030",
          "X1-9050": "X1-9050",
          "X2-9060": "X2-9060",
          "X2-6070": "X2-6070",
          "X3-9060": "X3-9060",
          "X3-9070": "X3-9070",
          "X3-6070": "X3-6070",
          "X4-9060": "X4-9060",
          "X4-9070": "X4-9070",
          "X4-6080": "X4-6080"
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "processAlias",
          "to": "processKey",
          "default": ""
        },
        {
          "op": "map",
          "from": "processKey",
          "table": "ymtc.process",
          "to": "processObj",
          "default": {}
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "ymtc",
        "device.chipKind": "raw_nand",
        "fields.process_node": {
          "$path": [
            "processObj",
            "process_node"
          ]
        },
        "fields.cell_level": {
          "$path": [
            "processObj",
            "cell_level"
          ]
        },
        "fields.generation_info": {
          "$path": [
            "processObj",
            "generation_info"
          ]
        },
        "fields.layer_count": {
          "$path": [
            "processObj",
            "layer_count"
          ]
        },
        "fields.die_density": {
          "$path": [
            "processObj",
            "die_density"
          ]
        },
        "fields.plane_count": {
          "$path": [
            "processObj",
            "plane_count"
          ]
        },
        "fields.speed_grade": {
          "$path": [
            "processObj",
            "speed_grade"
          ]
        },
        "meta.ruleId": "vendor.ymtc.process-alias.v1",
        "meta.processKey": {
          "$var": "processKey"
        },
        "meta.processCodename": {
          "$path": [
            "processObj",
            "meta",
            "codename"
          ]
        }
      }
    }
  }
]
