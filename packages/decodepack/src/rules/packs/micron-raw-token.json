      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "enterprise_token"
        },
        {
          "op": "map",
          "from": "enterprise_token",
          "table": "enterprise_flag",
          "to": "enterprise",
          "default": false
        },
        {
          "op": "map",
          "from": "enterprise_token",
          "table": "mt29fb_marker_prefix",
          "to": "canStripMt29fbMarker",
          "default": false
        },
        {
          "op": "stripIfPrefix",
          "prefix": "B",
          "to": "mt29fbMarker",
          "if": "canStripMt29fbMarker"
        },
        {
          "op": "set",
          "to": "type",
          "value": "nand"
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": null
        },
        {
          "op": "take",
          "len": 2,
          "to": "device_token"
        },
        {
          "op": "map",
          "from": "device_token",
          "table": "device_width",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "cell_token"
        },
        {
          "op": "map",
          "from": "cell_token",
          "table": "cell_level",
          "to": "cellLevel",
          "default": null
        },
        {
          "op": "take",
          "len": 1,
          "to": "class_token"
        },
        {
          "op": "map",
          "from": "class_token",
          "table": "classification",
          "to": "classification",
          "default": {
            "ce": -1,
            "ch": -1,
            "rb": -1,
            "die": -1
          }
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltage_token"
        },
        {
          "op": "map",
          "from": "voltage_token",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "die_token"
        },
        {
          "op": "map",
          "from": "die_token",
          "table": "die_code",
          "to": "die_code",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "interface_token"
        },
        {
          "op": "map",
          "from": "interface_token",
          "table": "interface",
          "to": "interface",
          "default": {
            "async": false,
            "sync": false
          }
        },
        {
          "op": "map",
          "from": "interface_token",
          "table": "interface_info",
          "to": "interface_type",
          "default": "Unknown"
        },
        {
          "op": "takeLongest",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9A-Z]+",
          "to": "suffixCode",
          "default": ""
        },
        {
          "op": "stripIfPrefix",
          "prefix": ":"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9A-Z]+",
          "to": "revisionCode",
          "default": ""
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "enterprise": {
              "$var": "enterprise"
            },
            "die_code": {
              "$var": "die_code"
            },
            "interface_type": {
              "$var": "interface_type"
            }
          }
        },
        {
          "op": "map",
          "from": "type",
          "table": "draftChipKind",
          "to": "draftChipKind",
          "default": "raw_nand"
        },
        {
          "op": "map",
          "from": "type",
          "table": "draftProductType",
          "to": "draftProductType",
          "default": null
        }
      ],
