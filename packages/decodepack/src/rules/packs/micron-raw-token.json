          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "micron",
        "device.chipKind": {
          "$var": "draftChipKind"
        },
        "device.productType": {
          "$var": "draftProductType"
        },
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.device_width": {
          "$var": "deviceWidth"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.die_count": {
          "$path": [
            "classification",
            "die"
          ]
        },
        "fields.ce_count": {
          "$path": [
            "classification",
            "ce"
          ]
        },
        "fields.rb_count": {
          "$path": [
            "classification",
            "rb"
          ]
        },
        "fields.channel_count": {
          "$path": [
            "classification",
            "ch"
          ]
        },
        "fields.voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.micron.token.v1"
