      "steps": [
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "componentCode"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentObj",
          "to": "componentObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controllerRevision",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "temperatureObj",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "productionStatusObj",
          "to": "productionStatusObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "Micron managed NAND",
            "group": "eMMC",
            "product_version": "eMMC",
            "nand_component": {
              "$var": "componentCode"
            },
            "controller_code": {
              "$var": "controllerCode"
            },
            "package_code": {
              "$var": "packageCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "componentObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productionStatusObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "micron",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.micron.emmc.mtfc.legacy.v1"
      }
    }
  }
