          }
        }
      },
      "steps": [
        {
          "op": "takeRegex",
          "pattern": "^(S[A-Z])",
          "to": "gradeCode",
          "groups": {
            "gradeCode": 1
          }
        },
        {
          "op": "takeLongest",
          "table": "configToken",
          "to": "configCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "deviceWidth",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "takeRegex",
          "pattern": "^(([YZ])[0-9A-Z]{3})",
          "to": "designCode",
          "groups": {
            "designCode": 1,
            "designFamilyCode": 2
          }
        },
        {
          "op": "map",
          "from": "designFamilyCode",
          "table": "designTypeObj",
          "to": "designTypeObj",
          "default": {}
        },
        {
          "op": "takeRegex",
          "pattern": "^([DJP][0-9A-Z])",
          "to": "die_code",
          "groups": {
            "die_code": 1
          }
        },
        {
          "op": "map",
          "from": "die_code",
          "table": "dieCountObj",
          "to": "dieCountObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltageCode"
        },
        {
          "op": "map",
          "from": "voltageCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "takeRegex",
          "pattern": "^[A-Z][0-9A-Z]{1,2}",
          "to": "packageCode",
          "default": ""
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "speedToken",
          "to": "speedCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "speedCode",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$var": "configCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "designTypeObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dieCountObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "speedObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "spectek",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.config_code": {
          "$var": "configCode"
        },
        "meta.ruleId": "vendor.spectek.mobile-dram.component.v1",
        "meta.fieldProfile": "dram",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
    }
