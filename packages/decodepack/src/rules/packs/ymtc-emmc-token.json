[
  {
    "id": "vendor.ymtc.emmc-label.v1",
    "priority": 929,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^YMEC[456789A](?:A1|A2|B0)[MT][ABCE][12345]A2C[13]$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "YMEC"
      ],
      "tables": {
        "reference": {
          "YMEC_A1_A2": {
            "status": "external_confirmed",
            "source": "YMTC EC000/EC110 eMMC flyer with product model examples"
          },
          "YMTC_EC150": {
            "status": "external_confirmed",
            "source": "YMTC EC150 official product page"
          }
        },
        "deviceDensity": {
          "4": 65536,
          "5": 131072,
          "6": 262144,
          "7": 524288,
          "8": 1048576,
          "9": 2097152,
          "A": 4194304
        },
        "storageDensityObj": {
          "4": {
            "storage_density": "8GB eMMC"
          },
          "5": {
            "storage_density": "16GB eMMC"
          },
          "6": {
            "storage_density": "32GB eMMC"
          },
          "7": {
            "storage_density": "64GB eMMC"
          },
          "8": {
            "storage_density": "128GB eMMC"
          },
          "9": {
            "storage_density": "256GB eMMC"
          },
          "A": {
            "storage_density": "512GB eMMC"
          }
        },
        "controller": {
          "A1": {
            "controller": "eMMC 5.1 Controller EC000",
            "product_family": "YMTC EC000 eMMC",
            "storage_interface": "eMMC 5.1"
          },
          "A2": {
            "controller": "eMMC 5.1 Controller EC110",
            "product_family": "YMTC EC110 eMMC",
            "storage_interface": "eMMC 5.1"
          },
          "B0": {
            "controller": "eMMC 5.1 Controller EC230",
            "storage_interface": "eMMC 5.1"
          }
        },
        "cellLevel": {
          "M": 2,
          "T": 3
        },
        "processNode": {
          "A": "X0-A030 / DBS",
          "B": "X1-9050 / JGS",
          "C": "X2-9060 / TAS",
          "E": "X3-9060 / WYS"
        },
        "generation": {
          "A": 1,
          "B": 2,
          "C": 3,
          "E": 4
        },
        "dieStack": {
          "1": 1,
          "2": 2,
          "3": 4,
          "4": 8,
          "5": 16
        },
        "dieStackInfo": {
          "1": {
            "die_stack": "SDP (1-die)"
          },
          "2": {
            "die_stack": "DDP (2-die)"
          },
          "3": {
            "die_stack": "QDP (4-die)"
          },
          "4": {
            "die_stack": "ODP (8-die)"
          },
          "5": {
            "die_stack": "HDP (16-die)"
          }
        },
        "package": {
          "A2": "BGA-153 11.5x13x1.0"
        },
        "productClass": {
          "C": {
            "product_class": "Commercial"
          }
        },
        "temperature": {
          "1": {
            "operation_temperature": "-20°C ~ 85°C"
          },
          "3": {
            "operation_temperature": "-25°C ~ 85°C"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "deviceDensity",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "storageDensityObj",
          "to": "storageDensityObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controller",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "cellCode"
        },
        {
          "op": "map",
          "from": "cellCode",
          "table": "cellLevel",
          "to": "cellLevel",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "processNode",
          "to": "processNode",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "generation",
          "to": "generation",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "dieStackCode"
        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStack",
          "to": "die",
          "default": -1
        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStackInfo",
          "to": "dieStackObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "productClassCode"
        },
        {
          "op": "map",
          "from": "productClassCode",
          "table": "productClass",
          "to": "productClassObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "temperatureCode"
        },
        {
          "op": "map",
          "from": "temperatureCode",
          "table": "temperature",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "YMTC",
            "group": "eMMC"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "storageDensityObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dieStackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productClassObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "ymtc",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.process_node": {
          "$var": "processNode"
        },
        "fields.generation_info": {
          "$var": "generation"
        },
        "fields.package": {
          "$var": "package"
        },
        "fields.die_count": {
          "$path": [
            "classification",
            "die"
          ]
        },
        "fields.ce_count": {
          "$path": [
            "classification",
            "ce"
          ]
        },
        "fields.rb_count": {
          "$path": [
            "classification",
            "rb"
          ]
        },
        "fields.channel_count": {
          "$path": [
            "classification",
            "ch"
          ]
        },
        "meta.ruleId": "vendor.ymtc.emmc-label.v1"
      }
    }
  }
]
