          "op": "map",
          "from": "packageExactCode",
          "table": "packageExact",
          "to": "packageExact",
          "default": ""
        },
        {
          "op": "map",
          "from": "packageBaseCode",
          "table": "packageBase",
          "to": "packageBase",
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{packageBase}}:{{packageDetailCode}}",
          "to": "packageDetailKey"
        },
        {
          "op": "map",
          "from": "packageDetailKey",
          "table": "detailPackage",
          "to": "packageDetail",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "packageExact",
          "secondary": "packageDetail",
          "to": "packageWithDetail"
        },
        {
          "op": "fallback",
          "primary": "packageWithDetail",
          "secondary": "packageBase",
          "to": "package"
