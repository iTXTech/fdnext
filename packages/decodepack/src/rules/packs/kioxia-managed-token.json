      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "prefixCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltageCode"
        },
        {
          "op": "map",
          "from": "voltageCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "typeCode"
        },
        {
          "op": "map",
          "from": "typeCode",
          "table": "typeObj",
          "to": "typeObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "typeCode",
          "table": "draftProductType",
          "to": "draftProductType",
          "default": "emmc"
        },
        {
          "op": "take",
          "len": 1,
          "to": "controllerRevisionCode"
        },
        {
          "op": "tpl",
          "template": "{{voltageCode}}{{typeCode}}{{controllerRevisionCode}}",
          "to": "seriesCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "seriesObj",
          "to": "seriesObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "seriesCode",
