          "to": "seriesProcessNode",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "cellCode"
        },
        {
          "op": "map",
          "from": "cellCode",
          "table": "cellLevel",
          "to": "cellLevel",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "stackCode"
        },
        {
          "op": "map",
          "from": "stackCode",
          "table": "dieStack",
          "to": "dieStack",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "designRuleCode"
        },
        {
          "op": "tpl",
          "template": "{{processFamily}}:{{designRuleCode}}",
          "to": "twoDimensionalProcessKey"
        },
        {
          "op": "map",
          "from": "twoDimensionalProcessKey",
          "table": "twoDimensionalProcessNode",
          "to": "twoDimensionalProcessNode",
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{processFamily}}:{{stackCode}}",
          "to": "bicsProcessKey"
        },
        {
          "op": "map",
          "from": "bicsProcessKey",
          "table": "bicsProcessNode",
          "to": "bicsProcessNode",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "bicsProcessNode",
          "secondary": "twoDimensionalProcessNode",
          "to": "inferredProcessNode"
        },
        {
          "op": "fallback",
          "primary": "inferredProcessNode",
          "secondary": "seriesProcessNode",
          "to": "processNode"
        },
        {
          "op": "map",
