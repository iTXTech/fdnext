      "steps": [
        {
          "op": "take",
          "len": 2,
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "voltageToken",
          "to": "voltageCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "voltageCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{voltageCode}}",
          "to": "familyVoltageKey"
        },
        {
          "op": "map",
          "from": "familyVoltageKey",
          "table": "dramTypeOverrideObj",
          "to": "dramTypeOverrideObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "configToken",
          "to": "configCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "deviceWidth",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "takeLongest",
          "table": "deviceVersionToken",
          "to": "deviceVersionCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "deviceVersionCode",
          "table": "deviceVersionObj",
          "to": "deviceVersionObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "packageToken",
          "to": "packageCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "packageObj",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{packageCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageActual",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{voltageCode}}:{{configCode}}:{{packageCode}}",
          "to": "twinDieKey"
        },
        {
          "op": "map",
          "from": "twinDieKey",
          "table": "twinDieObj",
          "to": "twinDieObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "speedToken",
          "to": "speedCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "speedCode",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "temperatureObj",
          "to": "temperatureObj",
          "default": {
            "operation_temperature": "Commercial"
          }
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "productionStatusObj",
          "to": "productionStatusObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "stripIfPrefix",
          "prefix": ":"
        },
        {
          "op": "take",
          "len": 1,
          "to": "revisionCode"
        },
        {
          "op": "map",
          "from": "revisionCode",
          "table": "revisionObj",
          "to": "revisionObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$var": "configCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dramTypeOverrideObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "deviceVersionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "twinDieObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "speedObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productionStatusObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "revisionObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "micron",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "fields.config_code": {
          "$var": "configCode"
        },
        "meta.ruleId": "vendor.micron.dram.component.v1",
        "meta.fieldProfile": "dram",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
