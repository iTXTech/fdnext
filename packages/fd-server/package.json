{
  "name": "@itxtech/fd-server",
  "version": "3.1.0",
  "description": "FlashDetector-compatible HTTP server for fdnext",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "ecosystem.config.cjs",
    "wrangler.jsonc",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "bin": {
    "fd-server": "dist/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTXTech/fdnext.git",
    "directory": "packages/fd-server"
  },
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/fd-server",
  "bugs": {
    "url": "https://github.com/iTXTech/fdnext/issues"
  },
  "keywords": [
    "fdnext",
    "flashdetector",
    "fdwebserver",
    "server",
    "hapi",
    "flash",
    "nand"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@hapi/hapi": "^21.4.4",
    "@itxtech/fdnext-core": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b --emitDeclarationOnly && tsdown",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly",
    "worker:dev": "pnpm dlx wrangler dev --config wrangler.jsonc",
    "worker:deploy": "pnpm dlx wrangler deploy --config wrangler.jsonc",
    "worker:deploy:dry-run": "pnpm dlx wrangler deploy --dry-run --outdir ../../.wrangler-bundle/fd-server --config wrangler.jsonc"
  }
}
