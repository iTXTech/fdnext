[
  {
    "id": "vendor.kioxia.emmc.managed.v1",
    "priority": 1005,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^THG[AB]M[0-9A-Z]{10,13}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "THG"
      ],
      "tables": {
        "density": {
          "G5": 32768,
          "G6": 65536,
          "G7": 131072,
          "G8": 262144,
          "G9": 524288,
          "T0": 1048576,
          "T1": 2097152
        },
        "seriesObj": {
          "BMN": {
            "series_code": "BMN",
            "nand_technology": "FG NAND"
          },
          "BMT": {
            "series_code": "BMT",
            "nand_technology": "FG NAND"
          },
          "BMU": {
            "series_code": "BMU",
            "nand_technology": "FG NAND"
          },
          "BMJ": {
            "series_code": "BMJ",
            "nand_technology": "FG NAND"
          },
          "AMV": {
            "series_code": "AMV",
            "nand_technology": "BiCS FLASH"
          },
          "AMS": {
            "series_code": "AMS",
            "nand_technology": "BiCS FLASH"
          }
        },
        "versionObj": {
          "BMN": {
            "product_version": "eMMC 5.0",
            "storage_interface": "eMMC 5.0",
            "speed_grade": "400 MB/s"
          },
          "BMT": {
            "product_version": "eMMC 5.0",
            "storage_interface": "eMMC 5.0",
            "speed_grade": "400 MB/s"
          },
          "BMU": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          },
          "BMJ": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          },
          "AMV": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          },
          "AMS": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          }
        },
        "processNode": {
          "BMN": "FG NAND",
          "BMT": "FG NAND",
          "BMU": "FG NAND",
          "BMJ": "FG NAND",
          "AMV": "BiCS FLASH",
          "AMS": "BiCS FLASH"
        },
        "processFamily": {
          "BMN": "FG",
          "BMT": "FG",
          "BMU": "FG",
          "BMJ": "FG",
          "AMV": "BICS",
          "AMS": "BICS"
        },
        "twoDimensionalProcessNode": {
          "FG:A": "130 nm",
          "FG:B": "90 nm",
          "FG:C": "70 nm",
          "FG:D": "56 nm",
          "FG:E": "43 nm",
          "FG:F": "32 nm",
          "FG:G": "24 nm A-type",
          "FG:H": "24 nm B-type",
          "FG:J": "19 nm/1x",
          "FG:K": "A19 nm/1y",
          "FG:L": "15 nm/1z"
        },
        "bicsProcessNode": {
          "BICS:2": "BiCS2",
          "BICS:3": "BiCS3",
          "BICS:4": "BiCS4",
          "BICS:5": "BiCS5",
          "BICS:6": "BiCS6",
          "BICS:8": "BiCS8",
          "BICS:M": "BiCS4.5"
        },
        "twoDimensionalGenerationObj": {
          "FG:A": { "generation_info": "130 nm" },
          "FG:B": { "generation_info": "90 nm" },
          "FG:C": { "generation_info": "70 nm" },
          "FG:D": { "generation_info": "56 nm" },
          "FG:E": { "generation_info": "43 nm" },
          "FG:F": { "generation_info": "32 nm" },
          "FG:G": { "generation_info": "24 nm A-type" },
          "FG:H": { "generation_info": "24 nm B-type" },
          "FG:J": { "generation_info": "19 nm/1x" },
          "FG:K": { "generation_info": "A19 nm/1y" },
          "FG:L": { "generation_info": "15 nm/1z" }
        },
        "bicsGenerationObj": {
          "BICS:2": { "generation_info": "BiCS2" },
          "BICS:3": { "generation_info": "BiCS3" },
          "BICS:4": { "generation_info": "BiCS4" },
          "BICS:5": { "generation_info": "BiCS5" },
          "BICS:6": { "generation_info": "BiCS6" },
          "BICS:8": { "generation_info": "BiCS8" },
          "BICS:M": { "generation_info": "BiCS4.5" }
        },
        "classObj": {
          "BAI": {
            "product_class": "Consumer",
            "operation_temperature": "-25°C ~ 85°C"
          },
          "BAU": {
            "product_class": "Industrial",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "BAC": {
            "product_class": "Automotive AEC-Q100 Grade 2",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "BAB": {
            "product_class": "Automotive AEC-Q100 Grade 2",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "BAA": {
            "product_class": "Automotive AEC-Q100 Grade 3",
            "operation_temperature": "-40°C ~ 85°C"
          }
        },
        "packageBase": {
          "BA": "BGA",
          "LA": "LGA"
        },
        "packageExact": {
          "BAIT": "BGA153",
          "LA01": "LGA60"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "seriesCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "seriesObj",
          "to": "seriesObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "processFamily",
          "to": "processFamily",
          "default": ""
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "processNode",
          "to": "seriesProcessNode",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "versionObj",
          "to": "versionObj",
          "default": {
            "product_version": "eMMC"
          }
        },
        {
          "op": "take",
          "len": 1,
          "to": "packagePrefixCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "revisionCode"
        },
        {
          "op": "tpl",
          "template": "{{processFamily}}:{{revisionCode}}",
          "to": "twoDimensionalProcessKey"
        },
        {
          "op": "map",
          "from": "twoDimensionalProcessKey",
          "table": "twoDimensionalProcessNode",
          "to": "twoDimensionalProcessNode",
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{processFamily}}:{{generationCode}}",
          "to": "bicsProcessKey"
        },
        {
          "op": "map",
          "from": "bicsProcessKey",
          "table": "bicsProcessNode",
          "to": "bicsProcessNode",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "bicsProcessNode",
          "secondary": "twoDimensionalProcessNode",
          "to": "inferredProcessNode"
        },
        {
          "op": "fallback",
          "primary": "inferredProcessNode",
          "secondary": "seriesProcessNode",
          "to": "processNode"
        },
        {
          "op": "map",
          "from": "twoDimensionalProcessKey",
          "table": "twoDimensionalGenerationObj",
          "to": "twoDimensionalGenerationObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "bicsProcessKey",
          "table": "bicsGenerationObj",
          "to": "bicsGenerationObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageBaseCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "classSuffixCode"
        },
        {
          "op": "tpl",
          "template": "{{packageBaseCode}}{{classSuffixCode}}",
          "to": "classCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "packageDetailCode"
        },
        {
          "op": "tpl",
          "template": "{{classCode}}{{packageDetailCode}}",
          "to": "packageExactCode"
        },
        {
          "op": "map",
          "from": "classCode",
          "table": "classObj",
          "to": "classObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "packageExactCode",
          "table": "packageExact",
          "to": "packageExact",
          "default": ""
        },
        {
          "op": "map",
          "from": "packageBaseCode",
          "table": "packageBase",
          "to": "packageBase",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "packageExact",
          "secondary": "packageBase",
          "to": "package"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "KIOXIA managed NAND",
            "group": "eMMC"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "seriesObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "versionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "twoDimensionalGenerationObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "bicsGenerationObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "classObj"
        }
      ],
      "assign": {
        "vendor": "kioxia",
        "type": "emmc",
        "density": {
          "$var": "density"
        },
        "processNode": {
          "$var": "processNode"
        },
        "package": {
          "$var": "package"
        },
        "fields": {
          "$var": "extra"
        }
      }
    }
  }
]
