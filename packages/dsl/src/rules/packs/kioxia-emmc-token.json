[
  {
    "id": "vendor.kioxia.emmc.managed.v1",
    "priority": 1005,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^THG[AB]M[0-9A-Z]{10,13}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "THG"
      ],
      "tables": {
        "density": {
          "G5": 32768,
          "G6": 65536,
          "G7": 131072,
          "G8": 262144,
          "G9": 524288,
          "T0": 1048576,
          "T1": 2097152
        },
        "seriesObj": {
          "BMN": {
            "series_code": "BMN",
            "nand_technology": "FG NAND"
          },
          "BMT": {
            "series_code": "BMT",
            "nand_technology": "FG NAND"
          },
          "BMU": {
            "series_code": "BMU",
            "nand_technology": "FG NAND"
          },
          "BMJ": {
            "series_code": "BMJ",
            "nand_technology": "FG NAND"
          },
          "AMV": {
            "series_code": "AMV",
            "nand_technology": "BiCS FLASH"
          },
          "AMS": {
            "series_code": "AMS",
            "nand_technology": "BiCS FLASH"
          }
        },
        "versionObj": {
          "BMN": {
            "product_version": "eMMC 5.0",
            "storage_interface": "eMMC 5.0",
            "speed_grade": "400 MB/s"
          },
          "BMT": {
            "product_version": "eMMC 5.0",
            "storage_interface": "eMMC 5.0",
            "speed_grade": "400 MB/s"
          },
          "BMU": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          },
          "BMJ": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          },
          "AMV": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          },
          "AMS": {
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "speed_grade": "400 MB/s"
          }
        },
        "processNode": {
          "BMN": "FG NAND",
          "BMT": "FG NAND",
          "BMU": "FG NAND",
          "BMJ": "FG NAND",
          "AMV": "BiCS FLASH",
          "AMS": "BiCS FLASH"
        },
        "classObj": {
          "BAI": {
            "product_class": "Consumer",
            "opTemp": "-25°C ~ 85°C"
          },
          "BAU": {
            "product_class": "Industrial",
            "opTemp": "-40°C ~ 105°C"
          },
          "BAC": {
            "product_class": "Automotive AEC-Q100 Grade 2",
            "opTemp": "-40°C ~ 105°C"
          },
          "BAB": {
            "product_class": "Automotive AEC-Q100 Grade 2",
            "opTemp": "-40°C ~ 105°C"
          },
          "BAA": {
            "product_class": "Automotive AEC-Q100 Grade 3",
            "opTemp": "-40°C ~ 85°C"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "seriesCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "seriesObj",
          "to": "seriesObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "processNode",
          "to": "processNode",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "versionObj",
          "to": "versionObj",
          "default": {
            "product_version": "eMMC"
          }
        },
        {
          "op": "take",
          "len": 3,
          "to": "skipPackagePrefix"
        },
        {
          "op": "take",
          "len": 3,
          "to": "classCode"
        },
        {
          "op": "map",
          "from": "classCode",
          "table": "classObj",
          "to": "classObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "KIOXIA managed NAND",
            "group": "eMMC"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "seriesObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "versionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "classObj"
        }
      ],
      "assign": {
        "vendor": "kioxia",
        "type": "emmc",
        "density": {
          "$var": "density"
        },
        "processNode": {
          "$var": "processNode"
        },
        "extraInfo": {
          "$var": "extra"
        }
      }
    }
  }
]
