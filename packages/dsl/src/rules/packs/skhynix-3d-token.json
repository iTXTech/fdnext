        { "op": "take", "len": 1, "to": "generationCode" },
        { "op": "tpl", "template": "{{densityCode}}:{{generationCode}}", "to": "productKey" },
        { "op": "map", "from": "productKey", "table": "density", "to": "density", "default": 0 },
        { "op": "map", "from": "productKey", "table": "processNode", "to": "processNode", "default": "Unknown" },
        { "op": "map", "from": "productKey", "table": "productObj", "to": "productObj", "default": {} },
        { "op": "take", "len": 3, "to": "configCode" },
        { "op": "set", "to": "extra", "value": { "system": "SK hynix 4D NAND", "group": "Raw NAND", "nand_technology": "4D NAND", "density_code": { "$var": "densityCode" }, "generation_code": { "$var": "generationCode" }, "config_code": { "$var": "configCode" } } },
        { "op": "merge", "into": "extra", "from": "productObj" }
      ],
      "assign": {
        "vendor": "skhynix",
        "type": "nand",
        "density": { "$var": "density" },
        "processNode": { "$var": "processNode" },
        "deviceWidth": 8,
        "interface": { "toggle": true },
        "extraInfo": { "$var": "extra" }
      }
    }
