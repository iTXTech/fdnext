        "temperatureObj": {
          "CT": {
            "opTemp": "Commercial (0°C ~ 70°C)"
          },
          "WT": {
            "opTemp": "Standard (-25°C ~ 85°C)"
          },
          "IT": {
            "opTemp": "Extended (-40°C ~ 85°C)"
          },
          "AIT": {
            "opTemp": "Industrial (-40°C ~ 85°C + HR certified test flow)"
          },
          "AAT": {
            "opTemp": "Industrial (-40°C ~ 105°C + HR certified test flow)"
          },
          "AITI": {
