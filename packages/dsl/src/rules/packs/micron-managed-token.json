    "id": "vendor.micron.managed.mtfc.nextgen.v1",
    "priority": 1007,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^MTFC(?:12M|[0-9]{1,3}G|1T)[0-9A-Z]{6}(?:-[0-9A-Z]+)?(?:ES|MS|QS)?$"
    },
    "tokenDecoder": {
