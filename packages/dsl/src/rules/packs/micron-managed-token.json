        "productionStatusObj": {
          "ES": {
            "prod_status": "Engineering Sample"
          },
          "MS": {
            "prod_status": "Mechanical Sample"
          },
          "QS": {
            "prod_status": "Qualification Sample"
          }
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 2,
          "to": "componentCode"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentType",
          "to": "componentType",
          "default": "nandcon"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentObj",
          "to": "componentObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controllerRevision",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{componentCode}}:{{controllerCode}}",
          "to": "familyKey"
        },
        {
          "op": "map",
          "from": "familyKey",
          "table": "familyType",
          "to": "familyType",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "familyType",
          "secondary": "componentType",
          "to": "type"
        },
        {
          "op": "map",
          "from": "familyKey",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "specialOptionObj",
          "to": "specialOptionObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "temperatureObj",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "productionStatusObj",
          "to": "productionStatusObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "Micron managed NAND",
            "nand_component": {
              "$var": "componentCode"
            },
            "controller_code": {
              "$var": "controllerCode"
            },
            "package_code": {
              "$var": "packageCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "componentObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "specialOptionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productionStatusObj"
        }
      ],
      "assign": {
        "vendor": "micron",
        "type": {
          "$var": "type"
        },
        "density": {
          "$var": "density"
        },
        "package": {
          "$var": "package"
        },
        "extraInfo": {
          "$var": "extra"
        },
        "url": {
          "micron_website": {
            "$tpl": "https://www.micron.com/support/tools-and-utilities/fbga?matpart={{partNumber}}"
          }
        },
        "urls": [
          {
            "url": {
              "$tpl": "https://www.micron.com/support/tools-and-utilities/fbga?matpart={{partNumber}}"
            },
            "desc": "micron_website",
            "img": "logo",
            "hint": ""
          }
        ]
      }
    }
  }
