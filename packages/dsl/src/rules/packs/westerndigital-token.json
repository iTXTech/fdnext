  {
    "id": "vendor.westerndigital.unsupported.issd",
    "priority": 999,
    "normalize": ["trim", "uppercase", { "remove": [" ", ",", "&", ".", "|"] }],
    "match": { "kind": "prefix", "value": "SDIS" },
    "tokenDecoder": {
      "steps": [],
