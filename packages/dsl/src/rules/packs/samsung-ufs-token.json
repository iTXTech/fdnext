        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStack",
          "to": "die",
          "default": -1
        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStackInfo",
          "to": "dieStackObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
