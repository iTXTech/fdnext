[
  {
    "id": "vendor.micron.token.v1",
    "priority": 1000,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^(MT|29)"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "MT",
        "29"
      ],
      "tables": {
        "enterprise_flag": {
          "E": true
        },
        "density": {
