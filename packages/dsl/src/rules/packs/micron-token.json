          }
        },
        "package": {
          "WP": "48-pin TSOP I Center Package Leads (CPL) PB free",
          "WC": "48-pin TSOP I Off-center Package Leads (OCPL) PB free"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "enterprise_token"
        },
        {
          "op": "map",
          "from": "enterprise_token",
          "table": "enterprise_flag",
          "to": "enterprise",
          "default": false
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": null
        },
        {
          "op": "take",
          "len": 2,
          "to": "device_token"
        },
        {
          "op": "map",
          "from": "device_token",
          "table": "device_width",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "cell_token"
        },
        {
          "op": "map",
          "from": "cell_token",
          "table": "cell_level",
          "to": "cellLevel",
          "default": null
        },
        {
          "op": "take",
          "len": 1,
          "to": "class_token"
        },
        {
          "op": "map",
          "from": "class_token",
          "table": "classification",
          "to": "classification",
          "default": {
            "ce": -1,
            "ch": -1,
            "rb": -1,
            "die": -1
          }
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltage_token"
        },
        {
          "op": "map",
          "from": "voltage_token",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "generation_token"
        },
        {
          "op": "map",
          "from": "generation_token",
          "table": "generation",
          "to": "generation",
          "default": null
        },
        {
          "op": "take",
          "len": 1,
          "to": "interface_token"
        },
        {
          "op": "map",
          "from": "interface_token",
          "table": "interface",
          "to": "interface",
          "default": {
            "async": false,
            "sync": false
          }
        },
        {
          "op": "take",
          "len": 2,
          "to": "package_token"
        },
        {
          "op": "map",
          "from": "package_token",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        }
      ],
      "assign": {
        "vendor": "micron",
        "type": "nand",
        "density": {
          "$var": "density"
        },
        "deviceWidth": {
          "$var": "deviceWidth"
        },
        "cellLevel": {
          "$var": "cellLevel"
        },
        "classification": {
          "$var": "classification"
        },
        "voltage": {
          "$var": "voltage"
        },
        "generation": {
          "$var": "generation"
        },
        "interface": {
          "$var": "interface"
        },
        "package": {
          "$var": "package"
        },
        "extraInfo": {
          "enterprise": {
            "$var": "enterprise"
          }
        },
        "url": {
          "micron_website": {
            "$tpl": "https://www.micron.com/support/tools-and-utilities/fbga?matpart={{partNumber}}"
          }
        },
        "urls": [
          {
            "url": {
              "$tpl": "https://www.micron.com/support/tools-and-utilities/fbga?matpart={{partNumber}}"
            },
            "desc": "micron_website",
            "img": "logo",
            "hint": ""
          }
        ]
      }
    }
