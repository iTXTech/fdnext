[
  {
    "id": "vendor.kioxia.ufs.managed.v1",
    "priority": 1005,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^THG(?:AF|JF)[0-9A-Z]{10,13}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "THG"
      ],
      "tables": {
        "density": {
          "G8": 262144,
          "G9": 524288,
          "T0": 1048576,
          "T1": 2097152,
          "T2": 4194304,
          "T3": 8388608
        },
        "seriesObj": {
          "AFB": {
            "series_code": "AFB",
            "nand_technology": "BiCS FLASH"
          },
          "AFE": {
            "series_code": "AFE",
            "nand_technology": "BiCS FLASH"
          },
          "JFG": {
            "series_code": "JFG",
            "nand_technology": "BiCS FLASH"
          },
          "JFM": {
            "series_code": "JFM",
            "nand_technology": "BiCS FLASH"
          },
          "JFP": {
            "series_code": "JFP",
            "nand_technology": "BiCS FLASH"
          },
          "JFJ": {
            "series_code": "JFJ",
            "nand_technology": "BiCS FLASH"
          },
          "JFR": {
            "series_code": "JFR",
            "nand_technology": "BiCS FLASH"
          }
        },
        "versionObj": {
          "AFB": {
            "product_version": "UFS 2.1",
            "storage_interface": "UFS 2.1",
            "speed_grade": "1160 MB/s"
          },
          "AFE": {
            "product_version": "UFS 2.1",
            "storage_interface": "UFS 2.1",
            "speed_grade": "1160 MB/s"
          },
          "JFG": {
            "product_version": "UFS 3.1",
            "storage_interface": "UFS 3.1",
            "speed_grade": "2320 MB/s"
          },
          "JFP": {
            "product_version": "UFS 3.1",
            "storage_interface": "UFS 3.1",
            "speed_grade": "2320 MB/s"
          },
          "JFM": {
            "product_version": "UFS 4.0",
            "storage_interface": "UFS 4.0",
            "speed_grade": "4640 MB/s"
          },
          "JFJ": {
            "product_version": "UFS 4.0",
            "storage_interface": "UFS 4.0",
            "speed_grade": "4640 MB/s"
          },
          "JFR": {
            "product_version": "UFS 4.1",
            "storage_interface": "UFS 4.1",
            "speed_grade": "4640 MB/s"
          }
        },
        "processNode": {
          "AFB": "BiCS FLASH",
          "AFE": "BiCS FLASH",
          "JFG": "BiCS FLASH",
          "JFP": "BiCS FLASH",
          "JFM": "BiCS FLASH",
          "JFJ": "BiCS FLASH",
          "JFR": "BiCS FLASH"
        },
        "processFamily": {
          "AFB": "BICS",
          "AFE": "BICS",
          "JFG": "BICS",
          "JFM": "BICS",
          "JFP": "BICS",
          "JFJ": "BICS",
          "JFR": "BICS"
        },
        "bicsProcessNode": {
          "BICS:2": "BiCS2",
          "BICS:3": "BiCS3",
          "BICS:4": "BiCS4",
          "BICS:5": "BiCS5",
          "BICS:6": "BiCS6",
          "BICS:8": "BiCS8",
          "BICS:M": "BiCS4.5"
        },
        "bicsGenerationObj": {
          "BICS:2": {
            "generation_info": "BiCS2"
          },
          "BICS:3": {
            "generation_info": "BiCS3"
          },
          "BICS:4": {
            "generation_info": "BiCS4"
          },
          "BICS:5": {
            "generation_info": "BiCS5"
          },
          "BICS:6": {
            "generation_info": "BiCS6"
          },
          "BICS:8": {
            "generation_info": "BiCS8"
          },
          "BICS:M": {
            "generation_info": "BiCS4.5"
          }
        },
        "classObj": {
          "BAI": {
            "product_class": "Consumer / Industrial",
            "operation_temperature": "-25°C ~ 85°C"
          },
          "BAT": {
            "product_class": "Consumer / Industrial",
            "operation_temperature": "-25°C ~ 85°C"
          },
          "BAB": {
            "product_class": "Automotive AEC-Q100 Grade 2",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "BAA": {
            "product_class": "Automotive AEC-Q100 Grade 3",
            "operation_temperature": "-40°C ~ 85°C"
          }
        },
        "packageBase": {
          "BA": "BGA",
          "LA": "LGA"
        },
        "packageExact": {
          "BAIT": "BGA153",
          "LA01": "LGA60"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "seriesCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "seriesObj",
          "to": "seriesObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "processFamily",
          "to": "processFamily",
          "default": ""
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "processNode",
          "to": "seriesProcessNode",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "versionObj",
          "to": "versionObj",
          "default": {
            "product_version": "UFS"
          }
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "packagePrefixCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "tpl",
          "template": "{{processFamily}}:{{generationCode}}",
          "to": "bicsProcessKey"
        },
        {
          "op": "map",
          "from": "bicsProcessKey",
          "table": "bicsProcessNode",
          "to": "bicsProcessNode",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "bicsProcessNode",
          "secondary": "seriesProcessNode",
          "to": "processNode"
        },
        {
          "op": "map",
          "from": "bicsProcessKey",
          "table": "bicsGenerationObj",
          "to": "bicsGenerationObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "revisionCode"
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageBaseCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "classSuffixCode"
        },
        {
          "op": "tpl",
          "template": "{{packageBaseCode}}{{classSuffixCode}}",
          "to": "classCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "packageDetailCode"
        },
        {
          "op": "tpl",
          "template": "{{classCode}}{{packageDetailCode}}",
          "to": "packageExactCode"
        },
        {
          "op": "map",
          "from": "classCode",
          "table": "classObj",
          "to": "classObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "packageExactCode",
          "table": "packageExact",
          "to": "packageExact",
          "default": ""
        },
        {
          "op": "map",
          "from": "packageBaseCode",
          "table": "packageBase",
          "to": "packageBase",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "packageExact",
          "secondary": "packageBase",
          "to": "package"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "KIOXIA managed NAND",
            "group": "UFS"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "seriesObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "versionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "bicsGenerationObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "classObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "kioxia",
        "device.chipKind": "managed_nand",
        "device.productType": "ufs",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.process_node": {
          "$var": "processNode"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.kioxia.ufs.managed.v1"
      }
    }
  }
]
