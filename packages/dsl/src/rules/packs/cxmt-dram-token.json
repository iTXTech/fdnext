[
  {
    "id": "vendor.cxmt.dram.ddr4.component.v1",
    "priority": 1010,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^CXDQ[0-9A-Z]+(?:-[0-9A-Z]+)*$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "CXDQ"
      ],
      "tables": {
        "densityMb": {
          "3": 8192
        },
        "deviceWidth": {
          "B": 16
        },
        "packageActual": {
          "FAM": "96-ball FBGA"
        },
        "speedObj": {
          "CQ": {
            "dram_speed": "DDR4-2666",
            "operation_temperature": "Commercial (0C~95C)"
          },
          "CJ": {
            "dram_speed": "DDR4-3200",
            "operation_temperature": "Commercial (0C~95C)"
          },
          "IJ": {
            "dram_speed": "DDR4-3200",
            "operation_temperature": "Industrial (-40C~95C)"
          },
          "WQ": {
            "dram_speed": "DDR4-2666",
            "operation_temperature": "Wide temperature (-40C~95C)"
          }
        }
      },
      "steps": [
        {
          "op": "takeRegex",
          "pattern": "^([0-9])([A-Z])([0-9A-Z]{3})(?=-|$)",
          "to": "configFull",
          "groups": {
            "densityCode": 1,
            "widthCode": 2,
            "packageCode": 3
          },
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{densityCode}}{{widthCode}}",
          "to": "configCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "densityMb",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "widthCode",
          "table": "deviceWidth",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "packageActual",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-",
          "to": "hasSuffix"
        },
        {
          "op": "takeLongest",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "dram_type": "DDR4 SDRAM",
            "dram_die_stack": "Single die, 1 CS",
            "config_code": {
              "$var": "configCode"
            },
            "package_code": {
              "$var": "packageCode"
            }
          }
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "speedObj",
          "if": "hasSuffix"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "cxmt",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": "1.2V VDD",
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.cxmt.dram.ddr4.component.v1"
      }
    }
  },
