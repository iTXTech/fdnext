[
  {
    "id": "vendor.skhynix.4d.package.h25t.v1",
    "priority": 1008,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^H25T[0-9A-Z]{6,}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "H25T"
      ],
      "tables": {
        "density": {
          "2T:B": 2097152,
          "2T:C": 2097152
        },
        "processNode": {
          "1T:D": "238L 4D NAND",
          "2T:B": "176L 4D NAND",
          "2T:C": "4D NAND",
          "2T:D": "238L 4D NAND"
        },
        "productObj": {
          "1T:D": {
            "generation_info": "238-layer 4D NAND (V9 / H25FTD0)",
            "die_density": "512Gb",
            "die_stack": "4-die package observed",
            "product_class": "TLC"
          },
          "2T:B": {
            "generation_info": "176-layer 4D NAND (V7)",
            "component_density": "2Tb package",
            "product_class": "TLC"
          },
          "2T:C": {
            "generation_info": "4D NAND package family",
            "component_density": "2Tb package",
            "product_class": "QLC/TLC listing-dependent"
          },
          "2T:D": {
            "generation_info": "238-layer 4D NAND package family",
            "component_density": "2Tb package"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "tpl",
          "template": "{{densityCode}}:{{generationCode}}",
          "to": "productKey"
        },
        {
          "op": "map",
          "from": "productKey",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "productKey",
          "table": "processNode",
          "to": "processNode",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "productKey",
          "table": "productObj",
          "to": "productObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 3,
          "to": "configCode"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "SK hynix 4D NAND",
            "group": "Raw NAND",
            "nand_technology": "4D NAND",
            "density_code": {
              "$var": "densityCode"
            },
            "generation_code": {
              "$var": "generationCode"
            },
            "config_code": {
              "$var": "configCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productObj"
        }
      ],
      "assign": {
        "vendor": "skhynix",
        "type": "nand",
        "density": {
          "$var": "density"
        },
        "processNode": {
          "$var": "processNode"
        },
        "deviceWidth": 8,
        "interface": {
          "toggle": true
        },
        "extraInfo": {
          "$var": "extra"
        }
      }
    }
  }
]
