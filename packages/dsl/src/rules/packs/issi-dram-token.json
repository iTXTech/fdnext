[
  {
    "id": "vendor.issi.dram.standard.component.v1",
    "priority": 1010,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^IS(?:43|46)(?:TR|QR)[0-9A-Z]+(?:-[0-9A-Z]+)?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "IS43",
        "IS46"
      ],
      "tables": {
        "familyObj": {
          "TR": {
            "dram_type": "DDR3 SDRAM"
          },
          "QR": {
            "dram_type": "DDR4 SDRAM"
          }
        },
        "voltage": {
          "TR:false": "1.5V VDD",
          "TR:true": "1.35V or 1.5V VDD",
          "QR:false": "1.2V VDD",
          "QR:true": "1.2V VDD"
        },
        "configToken": {
          "16128": "16128",
          "16256": "16256",
          "16512": "16512",
          "16640": "16640",
          "81024": "81024",
          "81280": "81280",
          "82560": "82560",
          "85120": "85120",
          "16512S2": "16512S2",
          "8K02S2": "8K02S2",
          "16K01S2": "16K01S2"
        },
        "configObj": {
          "16128": {
            "density": 2048,
            "device_width": 16,
            "config_code": "128M16",
            "package": "96-ball BGA"
          },
          "16256": {
            "density": 4096,
            "device_width": 16,
            "config_code": "256M16",
            "package": "96-ball BGA"
          },
          "16512": {
            "density": 8192,
            "device_width": 16,
            "config_code": "512M16",
            "package": "96-ball BGA"
          },
          "16640": {
            "density": 1024,
            "device_width": 16,
            "config_code": "64M16",
            "package": "96-ball BGA"
          },
          "81024": {
            "density": 8192,
            "device_width": 8,
            "config_code": "1G8",
            "package": "78-ball BGA"
          },
          "81280": {
            "density": 1024,
            "device_width": 8,
            "config_code": "128M8",
            "package": "78-ball BGA"
          },
          "82560": {
            "density": 2048,
            "device_width": 8,
            "config_code": "256M8",
            "package": "78-ball BGA"
          },
          "85120": {
            "density": 4096,
            "device_width": 8,
            "config_code": "512M8",
            "package": "78-ball BGA"
          },
          "16512S2": {
            "density": 8192,
            "device_width": 16,
            "config_code": "512M16 S2",
            "package": "96-ball BGA"
          },
          "8K02S2": {
            "density": 16384,
            "device_width": 8,
            "config_code": "2G8 S2",
            "package": "78-ball BGA"
          },
          "16K01S2": {
            "density": 16384,
            "device_width": 16,
            "config_code": "1G16 S2",
            "package": "96-ball BGA"
          }
        },
        "stackObj": {
          "16512": {
            "dram_die_stack": "Single rank, 1 CS"
          },
          "16512S2": {
            "dram_die_stack": "Stacked, dual rank, 2 CS"
          },
          "8K02S2": {
            "dram_die_stack": "Stacked, dual rank, 2 CS"
          },
          "16K01S2": {
            "dram_die_stack": "Stacked, dual rank, 2 CS"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 2,
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "configToken",
          "to": "configToken",
          "default": ""
        },
        {
          "op": "map",
          "from": "configToken",
          "table": "configObj",
          "to": "configObj",
          "default": {}
        },
        {
          "op": "takeRegex",
          "pattern": "^(EC|[A-Z])(L?)",
          "to": "revisionTail",
          "groups": {
            "revisionCode": 1,
            "lowVoltageMarker": 2
          },
          "default": ""
        },
        {
          "op": "notEmpty",
          "from": "lowVoltageMarker",
          "to": "isLowVoltage"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{isLowVoltage}}",
          "to": "voltageKey"
        },
        {
          "op": "map",
          "from": "voltageKey",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}{{revisionCode}}",
          "to": "revisionLabel"
        },
        {
          "op": "map",
          "from": "configToken",
          "table": "stackObj",
          "to": "tailStackObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$path": "configObj.config_code"
            },
            "die_revision": {
              "$var": "revisionCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "tailStackObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "issi",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$path": "configObj.density"
        },
        "fields.dram_width": {
          "$path": "configObj.device_width"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$path": "configObj.package"
        },
        "meta.ruleId": "vendor.issi.dram.standard.component.v1",
        "meta.fieldProfile": "dram",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
    }
  },
