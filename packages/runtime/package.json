{
  "name": "@itxtech/fdnext-runtime",
  "version": "2.3.0",
  "description": "Platform-neutral fdnext HTTP and operation dispatch runtime",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTXTech/fdnext.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/runtime",
  "bugs": {
    "url": "https://github.com/iTXTech/fdnext/issues"
  },
  "keywords": [
    "fdnext",
    "runtime",
    "http",
    "flash",
    "nand"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*",
    "@itxtech/fdnext-decodepack": "workspace:*",
    "@itxtech/fdnext-resources": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}