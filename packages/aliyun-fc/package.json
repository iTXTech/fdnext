{
  "name": "@itxtech/fdnext-aliyun-fc",
  "version": "3.2.0",
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/aliyun-fc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fdnext-aliyun-fc": "dist/bin.js"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b --emitDeclarationOnly && tsdown",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}
