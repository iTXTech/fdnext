{
  "name": "@itxtech/fdnext-server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fdnext-server": "dist/bin.js"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*",
    "@itxtech/fdnext-dsl": "workspace:*",
    "@itxtech/fdnext-resources": "workspace:*",
    "@hapi/hapi": "^21.4.4"
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}
