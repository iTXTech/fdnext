{
  "name": "@itxtech/fdnext-server",
  "version": "2.3.0",
  "description": "Hapi HTTP server adapter for fdnext",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fdnext-server": "dist/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTXTech/fdnext.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/server",
  "bugs": {
    "url": "https://github.com/iTXTech/fdnext/issues"
  },
  "keywords": [
    "fdnext",
    "server",
    "hapi",
    "flash",
    "nand"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*",
    "@itxtech/fdnext-decodepack": "workspace:*",
    "@itxtech/fdnext-runtime": "workspace:*",
    "@itxtech/fdnext-resources": "workspace:*",
    "@hapi/hapi": "^21.4.4"
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}