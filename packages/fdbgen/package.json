{
  "name": "@itxtech/fdnext-fdbgen",
  "version": "2.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fdnext-fdbgen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  },
  "dependencies": {
    "@itxtech/fdnext-decodepack": "workspace:*"
  }
}
