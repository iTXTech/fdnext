{
  "name": "@itxtech/fdnext-fdbgen",
  "version": "3.0.0",
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/fdbgen",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fdnext-fdbgen": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b --emitDeclarationOnly && tsdown",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  },
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*"
  }
}
