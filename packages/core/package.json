{
  "name": "@itxtech/fdnext-core",
  "version": "2.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/loaders/node.d.ts",
      "default": "./dist/loaders/node.js"
    }
  },
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly && pnpm -s tsx ../../scripts/bundle-package.ts",
    "test": "tsx test/result-contract.test.ts",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}
