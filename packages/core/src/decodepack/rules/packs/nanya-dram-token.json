          "to": "package"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "ddr4BaseObj",
          "to": "ddr4BaseObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{deviceVersionCode}}",
          "to": "ddr4DieKey"
        },
        {
          "op": "map",
          "from": "ddr4DieKey",
          "table": "ddr4DieObj",
          "to": "ddr4DieObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-",
          "to": "hasSuffix"
        },
        {
          "op": "takeLongest",
          "table": "speedToken",
          "scope": "familyCode",
          "to": "speedCode"
        },
        {
          "op": "map",
          "from": "speedCode",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "gradeCode"
        },
        {
          "op": "map",
          "from": "gradeCode",
          "table": "gradeObj",
          "to": "gradeObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "dram_die_count": 1,
            "cs_count": 1,
            "config_code": {
              "$var": "configCode"
            },
            "package_code": {
              "$var": "packageCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "stackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "ddr4BaseObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "ddr4BankObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "ddr4DieObj"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "speedObj",
          "if": "hasSuffix"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "gradeObj",
          "if": "hasSuffix"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "config_code",
            "package_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "nanya",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.nanya.dram.standard.component.v1"
      }
    }
