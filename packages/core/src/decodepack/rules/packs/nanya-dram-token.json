          "a": "depth",
          "b": "width",
          "to": "density",
          "default": 0
        },
        {
          "op": "set",
          "to": "one",
          "value": 1
        },
        {
          "op": "mul",
          "a": "width",
          "b": "one",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "map",
          "from": "stackCode",
          "table": "stackObj",
          "to": "stackObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageCode"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{packageCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageActual",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-",
          "to": "hasSuffix"
        },
        {
          "op": "take",
          "len": 2,
          "to": "speedCode"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{speedCode}}",
          "to": "speedKey"
        },
        {
          "op": "map",
          "from": "speedKey",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "gradeCode"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{gradeCode}}",
          "to": "gradeKey"
        },
        {
          "op": "map",
          "from": "gradeKey",
          "table": "gradeObj",
          "to": "gradeObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$var": "configCode"
            },
            "package_code": {
              "$var": "packageCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "stackObj"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "speedObj",
          "if": "hasSuffix"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "gradeObj",
          "if": "hasSuffix"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "nanya",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.nanya.dram.low_power.component.v1"
      }
    }
  }
]
