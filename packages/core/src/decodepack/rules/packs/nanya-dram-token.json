      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "takeRegex",
          "pattern": "^([0-9]+)([MTF])([0-9]+)",
          "to": "configCode",
          "groups": {
            "depth": 1,
            "stackCode": 2,
            "width": 3
          },
          "default": ""
        },
        {
          "op": "mul",
          "a": "depth",
          "b": "width",
          "to": "density",
          "default": 0
        },
        {
          "op": "set",
          "to": "one",
          "value": 1
        },
        {
          "op": "mul",
          "a": "width",
          "b": "one",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "map",
          "from": "stackCode",
          "table": "stackObj",
          "to": "stackObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{stackCode}}",
          "to": "familyStackKey"
        },
        {
          "op": "map",
          "from": "familyStackKey",
          "table": "familyStackObj",
          "to": "familyStackObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "lowPowerBaseObj",
          "to": "baseObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{deviceWidth}}",
          "to": "channelKey"
        },
        {
          "op": "map",
          "from": "channelKey",
          "table": "channelObj",
          "to": "channelObj",
          "default": {}
        },
        {
          "op": "takeRegex",
          "pattern": "^([A-Z])([0-9A-Z])",
          "to": "packageCode",
          "groups": {
            "deviceVersionCode": 1,
            "packageShapeCode": 2
          },
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{packageCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageActual",
          "to": "genericPackage"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{configCode}}:{{packageCode}}",
          "to": "configPackageKey"
        },
        {
          "op": "map",
          "from": "configPackageKey",
          "table": "configPackageActual",
          "to": "configPackage",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "configPackage",
          "secondary": "genericPackage",
          "to": "package"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{deviceVersionCode}}",
          "to": "deviceVersionKey"
        },
        {
          "op": "map",
          "from": "deviceVersionKey",
          "table": "deviceVersionObj",
          "to": "deviceVersionObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-",
          "to": "hasSuffix"
        },
        {
          "op": "take",
          "len": 2,
          "to": "speedCode"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{speedCode}}",
          "to": "speedKey"
        },
        {
          "op": "map",
          "from": "speedKey",
          "table": "speedObj",
          "to": "genericSpeedObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{configCode}}:{{speedCode}}",
          "to": "configSpeedKey"
        },
        {
          "op": "map",
          "from": "configSpeedKey",
          "table": "configSpeedObj",
          "to": "configSpeedObj",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "configSpeedObj",
          "secondary": "genericSpeedObj",
          "to": "speedObj"
        },
        {
          "op": "take",
          "len": 1,
          "to": "gradeCode"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{gradeCode}}",
          "to": "gradeKey"
        },
        {
          "op": "map",
          "from": "gradeKey",
          "table": "gradeObj",
          "to": "gradeObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{deviceVersionCode}}:{{gradeCode}}",
          "to": "gradeOverrideKey"
        },
        {
          "op": "map",
          "from": "gradeOverrideKey",
          "table": "gradeOverrideObj",
          "to": "gradeOverrideObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$var": "configCode"
            },
            "package_code": {
              "$var": "packageCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "stackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyStackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "baseObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "channelObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "deviceVersionObj"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "speedObj",
          "if": "hasSuffix"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "gradeObj",
          "if": "hasSuffix"
        },
        {
          "op": "mergeIf",
          "into": "extra",
          "from": "gradeOverrideObj",
          "if": "hasSuffix"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "config_code",
            "package_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "nanya",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.nanya.dram.low_power.component.v1"
      }
    }
  }
