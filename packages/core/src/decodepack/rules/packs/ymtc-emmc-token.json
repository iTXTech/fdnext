[
  {
    "id": "vendor.ymtc.emmc-label.v1",
    "priority": 929,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^YMEC[456789A](?:A1|A2|B0)[MT][ABCE][12345]A2C[13]$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "YMEC"
      ],
      "tables": {
        "reference": {
          "YMEC_A1_A2": {
            "status": "external_confirmed",
            "source": "YMTC EC000/EC110 eMMC flyer with product model examples"
          },
          "YMTC_EC150": {
            "status": "external_confirmed",
            "source": "YMTC EC150 official product page"
          }
        },
        "deviceDensity": {
          "4": 65536,
          "5": 131072,
          "6": 262144,
          "7": 524288,
          "8": 1048576,
          "9": 2097152,
          "A": 4194304
        },
        "controller": {
          "A1": {
            "controller": "eMMC 5.1 Controller EC000",
            "product_family": "YMTC EC000 eMMC",
            "storage_interface": "eMMC 5.1"
          },
          "A2": {
            "controller": "eMMC 5.1 Controller EC110",
            "product_family": "YMTC EC110 eMMC",
            "storage_interface": "eMMC 5.1"
          },
          "B0": {
            "controller": "eMMC 5.1 Controller EC230",
            "storage_interface": "eMMC 5.1"
          }
        },
        "cellLevel": {
          "M": 2,
          "T": 3
        },
        "generation": {
          "A": 1,
          "B": 2,
          "C": 3,
          "E": 4
        },
        "dieStackInfo": {
          "1": {
            "die_count": 1
          },
          "2": {
            "die_count": 2
          },
          "3": {
            "die_count": 4
          },
          "4": {
            "die_count": 8
          },
          "5": {
            "die_count": 16
          }
        },
        "package": {
          "A2": "BGA-153, 11.5x13x1.0"
        },
        "productClass": {
          "C": {
            "product_class": "Commercial"
          }
        },
        "temperature": {
          "1": {
            "operation_temperature": "-20°C ~ 85°C"
          },
          "3": {
            "operation_temperature": "-25°C ~ 85°C"
          }
        },
        "processAlias": {
          "A": "DBS",
          "B": "JGS",
          "C": "TAS",
          "E": "WYS"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "deviceDensity",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 2,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controller",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "cellCode"
        },
        {
          "op": "map",
          "from": "cellCode",
          "table": "cellLevel",
          "to": "cellLevel",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "processAlias",
          "to": "processKey",
          "default": ""
        },
        {
          "op": "map",
          "from": "processKey",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "omit",
          "from": "processObj",
          "to": "processFields",
          "keys": [
            "meta",
            "firmware_match",
            "die_mark",
            "cell_level",
            "die_density",
            "plane_count",
            "speed_grade"
          ]
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "generation",
          "to": "generation",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "dieStackCode"
        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStackInfo",
          "to": "dieStackObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "package",
          "to": "package"
        },
        {
          "op": "take",
          "len": 1,
          "to": "productClassCode"
        },
        {
          "op": "map",
          "from": "productClassCode",
          "table": "productClass",
          "to": "productClassObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "temperatureCode"
        },
        {
          "op": "map",
          "from": "temperatureCode",
          "table": "temperature",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "YMTC",
            "group": "eMMC"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "processFields"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dieStackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productClassObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "ymtc",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.generation_info": {
          "$path": [
            "processFields",
            "generation_info"
          ]
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.nandDieProfileKey": {
          "$var": "processKey"
        },
        "meta.ruleId": "vendor.ymtc.emmc-label.v1",
        "fields.layer_count": {
          "$path": [
            "processFields",
            "layer_count"
          ]
        },
        "fields.die_codename": {
          "$path": [
            "processFields",
            "die_codename"
          ]
        }
      }
    }
  }
]
