[
  {
    "id": "vendor.winbond.raw.w29n.v1",
    "priority": 1005,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [" ", ",", "&", ".", "|", "-"]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^W29N(?:(?:01|02|04|08)[GHK][VWZ]|(?:04|08)L[WZ])(?:[A-Z0-9]{4})?$"
    },
    "tokenDecoder": {
      "stripPrefixes": ["W29N"],
      "tables": {
        "density": {
          "01": 1024,
          "02": 2048,
          "04": 4096,
          "08": 8192
        },
        "voltageWidthObj": {
          "V": {
            "voltage": "2.7V~3.6V",
            "device_width": 8
          },
          "W": {
            "voltage": "1.7V~1.95V",
            "device_width": 16
          },
          "Z": {
            "voltage": "1.7V~1.95V",
            "device_width": 8
          }
        },
        "package": {
          "S": "TSOP-I-48, 12x20",
          "D": "VFBGA-48, 6.5x8",
          "B": "VFBGA-63, 9x11",
          "Y": "WLCSP-68"
        },
        "temperatureObj": {
          "I": {
            "operation_temperature": "-40°C ~ 85°C"
          },
          "J": {
            "operation_temperature": "-40°C ~ 105°C"
          }
        },
        "optionObj": {
          "K:A": {
            "special_option": "OTP Command Supported"
          },
          "L:B": {
            "special_option": "Legacy OTP"
          },
          "L:C": {
            "special_option": "Legacy OTP and Block Lock"
          }
        },
        "eccObj": {
          "A": {
            "ecc_level": "1bit"
          },
          "F": {
            "ecc_level": "4bit"
          },
          "E": {
            "ecc_level": "8bit"
          },
          "G": {
            "ecc_level": "8bit"
          }
        }
      },
      "steps": [
        { "op": "take", "len": 2, "to": "densityCode" },
        { "op": "map", "from": "densityCode", "table": "density", "to": "density" },
        { "op": "take", "len": 1, "to": "featureCode" },
        { "op": "take", "len": 1, "to": "voltageWidthCode" },
        { "op": "map", "from": "voltageWidthCode", "table": "voltageWidthObj", "to": "voltageWidthObj", "default": {} },
        { "op": "take", "len": 1, "to": "packageCode" },
        { "op": "map", "from": "packageCode", "table": "package", "to": "package" },
        { "op": "take", "len": 1, "to": "temperatureCode" },
        { "op": "map", "from": "temperatureCode", "table": "temperatureObj", "to": "temperatureObj", "default": {} },
        { "op": "take", "len": 1, "to": "optionCode" },
        { "op": "tpl", "template": "{{featureCode}}:{{optionCode}}", "to": "optionKey" },
        { "op": "map", "from": "optionKey", "table": "optionObj", "to": "optionObj", "default": {} },
        { "op": "take", "len": 1, "to": "eccCode" },
        { "op": "map", "from": "eccCode", "table": "eccObj", "to": "eccObj", "default": {} },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "product_family": "Winbond ONFI NAND",
            "interface_type": "ONFI parallel NAND",
            "cell_level": "SLC"
          }
        },
        { "op": "merge", "into": "extra", "from": "voltageWidthObj" },
        { "op": "merge", "into": "extra", "from": "temperatureObj" },
        { "op": "merge", "into": "extra", "from": "optionObj" },
        { "op": "merge", "into": "extra", "from": "eccObj" }
      ],
      "assign": {
        "device.partNumber": { "$var": "partNumber" },
        "device.domain": "memory",
        "device.vendor": "winbond",
        "device.chipKind": "raw_nand",
        "fields": { "$var": "extra" },
        "fields.density": { "$var": "density" },
        "fields.package": { "$var": "package" },
        "meta.ruleId": "vendor.winbond.raw.w29n.v1"
      }
    }
  },
  {
    "id": "vendor.winbond.raw.w25n.v1",
