      "steps": [
        {
          "op": "takeLongest",
          "table": "familyToken",
          "to": "familyToken",
          "default": ""
        },
        {
          "op": "map",
          "from": "familyToken",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyToken",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "familyToken",
          "table": "familySpeedObj",
          "to": "familySpeedObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "configToken",
          "to": "configToken",
          "default": ""
        },
        {
          "op": "map",
          "from": "configToken",
          "table": "configObj",
          "to": "configObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "deviceWidth",
          "value": {
            "$path": "configObj.device_width"
          }
        },
        {
          "op": "takeRegex",
          "pattern": "^([0-9A-Z]{0,3})$",
          "to": "packageCode",
          "groups": {
            "packageCode": 1
          },
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{familyToken}}:{{deviceWidth}}:{{packageCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageObj",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "packageCodeObj",
          "to": "packageCodeObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "speedOverrideObj",
          "to": "speedOverrideObj",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "speedOverrideObj",
          "secondary": "familySpeedObj",
          "to": "speedObj"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$path": "configObj.config_code"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "speedObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageCodeObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "esmt",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$path": "configObj.density"
        },
        "fields.dram_width": {
          "$path": "configObj.device_width"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$path": "packageObj.package"
        },
        "meta.ruleId": "vendor.esmt.dram.component.v1",
        "meta.fieldProfile": "dram",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
