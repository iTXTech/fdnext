[
  {
    "id": "vendor.ymtc.ufs-label.v1",
    "priority": 929,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^YMUS[6789A](?:A1|A4|B2|B4|B5)[TQ][BCEFH][12345](?:A1|A2|D1|D2)C1$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "YMUS"
      ],
      "tables": {
        "deviceDensity": {
          "6": 262144,
          "7": 524288,
          "8": 1048576,
          "9": 2097152,
          "A": 4194304
        },
        "controller": {
          "A1": {
            "controller": "UFS 3.1 Controller",
            "storage_interface": "UFS 3.1"
          },
          "A4": {
            "controller": "UFS 2.2 Controller UC114",
            "storage_interface": "UFS 2.2"
          },
          "B2": {
            "controller": "UFS 2.2 Controller UC234",
            "storage_interface": "UFS 2.2"
          },
          "B4": {
            "controller": "UFS 3.1 Controller UC341",
            "storage_interface": "UFS 3.1"
          },
          "B5": {
            "controller": "UFS 2.2 Controller UC260",
            "storage_interface": "UFS 2.2"
          }
        },
        "cellLevel": {
          "T": 3,
          "Q": 4
        },
        "generation": {
          "B": 2,
          "C": 3,
          "E": 4,
          "F": 3,
          "H": 4
        },
        "dieStackInfo": {
          "1": {
            "die_count": 1
          },
          "2": {
            "die_count": 2
          },
          "3": {
            "die_count": 4
          },
          "4": {
            "die_count": 8
          },
          "5": {
            "die_count": 16
          }
        },
        "package": {
          "A1": "BGA-153, 11.5x13x0.8",
          "A2": "BGA-153, 11.5x13x1.0/1.2",
          "D1": "BGA-153, 11x13x0.8",
          "D2": "BGA-153, 11x13x1.0"
        },
        "productClass": {
          "C": {
            "product_class": "Commercial"
          }
        },
        "temperature": {
          "1": {
            "operation_temperature": "-25°C ~ 85°C"
          }
        },
        "processAlias": {
          "B": "JGS",
          "C": "TAS",
          "E": "WYS"
        },
        "controllerGenerationObj": {
          "B4:F": {
            "generation_info": "Gen4 Xtacking 3.0"
          },
          "B5:H": {
            "generation_info": "Gen5 Xtacking 4.0"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "deviceDensity",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 2,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controller",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "cellCode"
        },
        {
          "op": "map",
          "from": "cellCode",
          "table": "cellLevel",
          "to": "cellLevel",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "processAlias",
          "to": "processKey",
          "default": ""
        },
        {
          "op": "map",
          "from": "processKey",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "omit",
          "from": "processObj",
          "to": "processFields",
          "keys": [
            "meta",
            "firmware_match",
            "die_mark",
            "cell_level",
            "die_density",
            "plane_count",
            "speed_grade"
          ]
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "generation",
          "to": "generation",
          "default": "Unknown"
        },
        {
          "op": "tpl",
          "template": "{{controllerCode}}:{{generationCode}}",
          "to": "controllerGenerationKey"
        },
        {
          "op": "map",
          "from": "controllerGenerationKey",
          "table": "controllerGenerationObj",
          "to": "controllerGenerationObj",
          "default": {}
        },
        {
          "op": "merge",
          "into": "processFields",
          "from": "controllerGenerationObj"
        },
        {
          "op": "take",
          "len": 1,
          "to": "dieStackCode"
        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStackInfo",
          "to": "dieStackObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "package",
          "to": "package"
        },
        {
          "op": "take",
          "len": 1,
          "to": "productClassCode"
        },
        {
          "op": "map",
          "from": "productClassCode",
          "table": "productClass",
          "to": "productClassObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "temperatureCode"
        },
        {
          "op": "map",
          "from": "temperatureCode",
          "table": "temperature",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "YMTC",
            "group": "UFS"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "processFields"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dieStackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productClassObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "ymtc",
        "device.chipKind": "managed_nand",
        "device.productType": "ufs",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.generation_info": {
          "$path": [
            "processFields",
            "generation_info"
          ]
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.nandDieProfileKey": {
          "$var": "processKey"
        },
        "meta.ruleId": "vendor.ymtc.ufs-label.v1",
        "fields.layer_count": {
          "$path": [
            "processFields",
            "layer_count"
          ]
        },
        "fields.die_codename": {
          "$path": [
            "processFields",
            "die_codename"
          ]
        }
      }
    }
  }
]
