[
  {
    "id": "vendor.samsung.emmc.token.v1",
    "priority": 960,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^KLM(?:4G|8G|AG|BG|CG|DG|EG|FG)[1248AI][FGJKVURNLWY][CE][0-9A-Z][0-9A-Z](?:-?[BCEF][0-9A-Z][0-9A-Z][12PQ])?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "KLM"
      ],
      "tables": {
        "density": {
          "4G": 32768,
          "8G": 65536,
          "AG": 131072,
          "BG": 262144,
          "CG": 524288,
          "DG": 1048576,
          "EG": 2097152,
          "FG": 4194304
        },
        "dieStackInfo": {
          "1": {
            "die_count": 1
          },
          "2": {
            "die_count": 2
          },
          "4": {
            "die_count": 4
          },
          "8": {
            "die_count": 8
          },
          "A": {
            "die_count": 16
          },
          "I": {
            "die_count": 1
          }
        },
        "cellLevel": {
          "F": 2,
          "G": 2,
          "J": 2,
          "K": 2,
          "V": 3,
          "U": 3,
          "R": 3,
          "N": 3,
          "L": 4
        },
        "dieDensityObj": {
          "F": {
            "die_density": "32Gb"
          },
          "G": {
            "die_density": "64Gb"
          },
          "J": {
            "die_density": "128Gb"
          },
          "K": {
            "die_density": "256Gb"
          },
          "V": {
            "die_density": "128Gb"
          },
          "U": {
            "die_density": "256Gb"
          },
          "R": {
            "die_density": "512Gb"
          },
          "N": {
            "die_density": "1Tb"
          },
          "L": {
            "die_density": "1Tb"
          },
          "W": {
            "die_density": "64Gb"
          },
          "Y": {
            "die_density": "32Gb"
          }
        },
        "voltage": {
          "C": "VDD: 2.7V ~ 3.6V, VDDQ: 1.7V ~ 1.95V / 2.7V ~ 3.6V",
          "E": "VDD: 2.7V ~ 3.6V, VDDQ: 1.7V ~ 1.95V / 2.7V ~ 3.6V"
        },
        "controller": {
          "M": {
            "controller": "eMMC 5.1 Controller"
          },
          "N": {
            "controller": "eMMC 5.1 Controller"
          },
          "T": {
            "controller": "eMMC 5.1 Controller"
          }
        },
        "nandGeneration": {
          "G:D": "SS16",
          "G:E": "SS14",
          "G:F": "SS14",
          "J:B": "SS14",
          "J:D": "SS14",
          "K:A": "SSV4",
          "V:E": "SSV3",
          "V:M": "SSV3",
          "U:A": "SSV4",
          "U:B": "SSV5",
          "U:C": "SSV6",
          "R:M": "SSV4",
          "R:A": "SSV5",
          "R:B": "SSV6",
          "R:D": "SSV7",
          "R:E": "SSV6P",
          "R:F": "SSV8",
          "N:B": "SSV8",
          "N:D": "SSV9",
          "L:C": "SSV7",
          "L:D": "SSV9"
        },
        "package": {
          "B": "BGA-153, 11.5x13"
        },
        "packageByControllerGenerationPackage": {
          "N:D:B": "BGA-153, 11.5x13x1.0",
          "S:D:B": "BGA-153, 11.5x13x1.0",
          "T:E:B": "BGA-153, 11.5x13x0.8",
          "U:D:B": "BGA-153, 11.5x13x1.2",
          "U:F:B": "BGA-153, 11.5x13x0.8"
        },
        "versionObj": {
          "0": {
            "controller": "eMMC 4.5 Controller",
            "interface_type": "HS200",
            "product_version": "eMMC 4.5"
          },
          "3": {
            "controller": "eMMC 5.0 Controller",
            "interface_type": "HS400",
            "product_version": "eMMC 5.0"
          },
          "4": {
            "product_version": "eMMC 5.1"
          }
        },
        "temperature": {
          "1": {
            "operation_temperature": "-25°C ~ 85°C"
          },
          "2": {
            "operation_temperature": "-40°C ~ 85°C"
          },
          "P": {
            "operation_temperature": "-40°C ~ 95°C Automotive Grade 3"
          },
          "Q": {
            "operation_temperature": "-40°C ~ 105°C Automotive Grade 2"
          }
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "dieStackCode"
        },
        {
          "op": "map",
          "from": "dieStackCode",
          "table": "dieStackInfo",
          "to": "dieStackObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "dieTypeCode"
        },
        {
          "op": "map",
          "from": "dieTypeCode",
          "table": "cellLevel",
          "to": "cellLevel",
          "default": -1
        },
        {
          "op": "map",
          "from": "dieTypeCode",
          "table": "dieDensityObj",
          "to": "dieDensityObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltageCode"
        },
        {
          "op": "map",
          "from": "voltageCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controller",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "tpl",
          "template": "{{dieTypeCode}}:{{generationCode}}",
          "to": "nandGenerationKey"
        },
        {
          "op": "map",
          "from": "nandGenerationKey",
          "table": "nandGeneration",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "map",
          "from": "processNode",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "take",
          "len": 1,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "packageDefault"
        },
        {
          "op": "tpl",
          "template": "{{controllerCode}}:{{generationCode}}:{{packageCode}}",
          "to": "packageCombinationKey"
        },
        {
          "op": "map",
          "from": "packageCombinationKey",
          "table": "packageByControllerGenerationPackage",
          "to": "packageOverride",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "packageOverride",
          "secondary": "packageDefault",
          "to": "package"
        },
        {
          "op": "take",
          "len": 1,
          "to": "reservedCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "versionCode"
        },
        {
          "op": "map",
          "from": "versionCode",
          "table": "versionObj",
          "to": "versionObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "temperatureCode"
        },
        {
          "op": "map",
          "from": "temperatureCode",
          "table": "temperature",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "moviNAND/MCP",
            "group": "eMMC",
            "interface_type": "HS400"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dieStackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dieDensityObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "versionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "samsung",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.nandDieProfileKey": {
          "$var": "processNode"
        },
        "meta.ruleId": "vendor.samsung.emmc.token.v1",
        "fields.generation_info": {
          "$path": "processObj.generation_info"
        },
        "fields.layer_count": {
          "$path": "processObj.layer_count"
        },
        "fields.die_codename": {
          "$path": "processObj.die_codename"
        }
      }
    }
  }
]
