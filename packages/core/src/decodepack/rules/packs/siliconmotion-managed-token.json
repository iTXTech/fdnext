[
  {
    "id": "vendor.siliconmotion.ferri.emmc.v1",
    "priority": 1002,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^SM662[GP][XEAB][CDEF]BFS$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "SM662"
      ],
      "tables": {
        "reference": {
          "siliconmotion_ferri_emmc_selection_guide": {
            "status": "external_table_confirmed",
            "source": "Silicon Motion Ferri-eMMC Selection Guide"
          }
        },
        "packageObj": {
          "G": {
            "package_code": "100-b",
            "package": "100-ball BGA"
          },
          "P": {
            "package_code": "153-b",
            "package": "153-ball BGA"
          }
        },
        "tempObj": {
          "X": {
            "product_class": "Commercial",
            "operation_temperature": "-25°C ~ +85°C"
          },
          "E": {
            "product_class": "Industrial",
            "operation_temperature": "-40°C ~ +85°C"
          },
          "A": {
            "product_class": "Automotive AEC-Q100 Grade 3",
            "operation_temperature": "-40°C ~ +85°C"
          },
          "B": {
            "product_class": "Automotive AEC-Q100 Grade 2",
            "operation_temperature": "-40°C ~ +105°C"
          }
        },
        "density": {
          "C": 524288,
          "D": 1048576,
          "E": 2097152,
          "F": 4194304
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "packageObj",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "tempCode"
        },
        {
          "op": "map",
          "from": "tempCode",
          "table": "tempObj",
          "to": "tempObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "product_family": "Ferri-eMMC",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400",
            "nand_technology": "3D TLC NAND"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "tempObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "siliconmotion",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": 3,
        "fields.package": {
          "$path": "packageObj.package"
        },
        "meta.ruleId": "vendor.siliconmotion.ferri.emmc.v1",
        "meta.fieldProfile": "managed_nand",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
    }
  },
