[
  {
    "id": "vendor.skhynix.e2nand.h2d_h2j.v1",
    "priority": 1000,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^H2[DJ]T[0-9A-Z]{9}(?:-?BC)?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "H2"
      ],
      "tables": {
        "density": {
          "CG": 65536,
          "DF": 65536,
          "DG": 131072,
          "EG": 262144,
          "FG": 524288,
          "VG": 786432,
          "1T": 1048576
        },
        "familyObj": {
          "D": {
            "product_family": "SK hynix E2NAND",
            "product_version": "E2NAND2.0",
            "generation_info": "26nm E2NAND2.0",
            "block_size": "2MB (8KB page)"
          },
          "J": {
            "product_family": "SK hynix E2NAND",
            "product_version": "E2NAND3.0",
            "block_size": "4MB"
          }
        },
        "processNode": {
          "D:1": "HY26",
          "J:1": "HY16M",
          "J:2": "HY20"
        },
        "voltage": {
          "D": "Vcc: 3.3V, VccQ: 3.3V",
          "J": "Vcc: 3.0V/3.3V, VccQ: 3.0V/3.3V"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "seriesCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "productCode"
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 3,
          "to": "configCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "techCode"
        },
        {
          "op": "tpl",
          "template": "{{seriesCode}}:{{techCode}}",
          "to": "processKey"
        },
        {
          "op": "map",
          "from": "processKey",
          "table": "processNode",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 3,
          "to": "packageCode"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "take",
          "len": 2,
          "to": "suffixCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "SK hynix E2NAND",
            "density_code": {
              "$var": "densityCode"
            },
            "config_code": {
              "$var": "configCode"
            },
            "package_code": {
              "$var": "packageCode"
            },
            "ecc_enabled": true
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "skhynix",
        "device.chipKind": "managed_nand",
        "device.productType": "e2nand",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.device_width": 8,
        "fields.cell_level": 2,
        "fields.voltage": {
          "$var": "voltage"
        },
        "fields.package": "VLGA",
        "meta.ruleId": "vendor.skhynix.e2nand.h2d_h2j.v1",
        "fields.die_codename": {
          "$var": "processNode"
        }
      }
    }
  }
]
