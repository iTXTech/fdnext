      "steps": [
        {
          "op": "take",
          "len": 2,
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "configToken",
          "to": "configToken",
          "default": ""
        },
        {
          "op": "map",
          "from": "configToken",
          "table": "configObj",
          "to": "configObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "configPackage",
          "value": {
            "$path": "configObj.package"
          }
        },
        {
          "op": "takeRegex",
          "pattern": "^(EC|[A-Z])(L?)",
          "to": "revisionTail",
          "groups": {
            "revisionCode": 1,
            "lowVoltageMarker": 2
          },
          "default": ""
        },
        {
          "op": "notEmpty",
          "from": "lowVoltageMarker",
          "to": "isLowVoltage"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{isLowVoltage}}",
          "to": "voltageKey"
        },
        {
          "op": "map",
          "from": "voltageKey",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}{{revisionCode}}",
          "to": "revisionLabel"
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{configToken}}:{{revisionCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageOverride",
          "to": "packageOverride",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "packageOverride",
          "secondary": "configPackage",
          "to": "basePackage"
        },
        {
          "op": "map",
          "from": "configToken",
          "table": "stackObj",
          "to": "tailStackObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "casLatencyObj",
          "to": "casLatencyObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "packageObj",
          "to": "suffixPackageObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "suffixPackage",
          "value": {
            "$path": "suffixPackageObj.package"
          }
        },
        {
          "op": "fallback",
          "primary": "suffixPackage",
          "secondary": "basePackage",
          "to": "package"
        },
        {
          "op": "takeLongest",
          "table": "solderObj",
          "to": "solderObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "temperatureObj",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$path": "configObj.config_code"
            },
            "die_revision": {
              "$var": "revisionCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "tailStackObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "speedObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "casLatencyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "suffixPackageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "solderObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "issi",
        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$path": "configObj.density"
        },
        "fields.dram_width": {
          "$path": "configObj.device_width"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.issi.dram.standard.component.v1",
        "meta.fieldProfile": "dram",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
    }
