[
  {
    "id": "vendor.sndk.inand.legacy-emmc.v1",
    "priority": 1006,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^SDIN(?:5C2|5C4|7DP4|7DU2|7LP4|8DE[124])-?(?:00[48]G|0(?:16|32|64)G|4G|8G|16G|32G|64G)(?:[-_][0-9A-Z]+)?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "SDIN"
      ],
      "tables": {
        "familyObj": {
          "5C2": {
            "product_family": "iNAND legacy eMMC",
            "storage_interface": "eMMC 4.41",
            "nand_technology": "MLC NAND"
          },
          "5C4": {
            "product_family": "iNAND legacy eMMC",
            "storage_interface": "eMMC 4.41",
            "nand_technology": "MLC NAND"
          },
          "7DP4": {
            "product_family": "iNAND legacy eMMC",
            "storage_interface": "eMMC",
            "nand_technology": "MLC NAND"
          },
          "7DU2": {
            "product_family": "iNAND Ultra",
            "storage_interface": "eMMC 4.41",
            "nand_technology": "X2 MLC NAND"
          },
          "7LP4": {
            "product_family": "iNAND legacy eMMC",
            "storage_interface": "eMMC",
            "nand_technology": "MLC NAND"
          },
          "8DE1": {
            "product_family": "Industrial iNAND",
            "storage_interface": "eMMC 4.51+ HS200",
            "nand_technology": "X2 MLC NAND"
          },
          "8DE2": {
            "product_family": "Industrial iNAND XT",
            "storage_interface": "eMMC 4.51+ HS200",
            "nand_technology": "X2 MLC NAND"
          },
          "8DE4": {
            "product_family": "Industrial iNAND",
            "storage_interface": "eMMC",
            "nand_technology": "MLC NAND"
          }
        },
        "processNode": {
          "5C2": "SNK24M",
          "5C4": "SNK24M",
          "7DP4": "SNK19M",
          "7DU2": "SNK19M",
          "7LP4": "SNK19M"
        },
        "density": {
          "4G": 32768,
          "004G": 32768,
          "8G": 65536,
          "008G": 65536,
          "16G": 131072,
          "016G": 131072,
          "32G": 262144,
          "032G": 262144,
          "64G": 524288,
          "064G": 524288,
          "128G": 1048576,
          "256G": 2097152,
          "512G": 4194304,
          "1T00": 8388608
        }
      },
      "steps": [
        {
          "op": "takeRegex",
          "pattern": "^(?:5C2|5C4|7DP4|7DU2|7LP4|8DE[124])",
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "processNode",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "_"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9A-Z]+",
          "to": "suffix",
          "default": ""
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "iNAND"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "sndk",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "meta.nandDieProfileKey": {
          "$var": "processNode"
        },
        "meta.ruleId": "vendor.sndk.inand.legacy-emmc.v1",
        "fields.die_codename": {
          "$var": "processNode"
        }
      }
    }
  }
]
