[
  {
    "id": "vendor.longsys.foresee.ufs.v1",
    "priority": 1001,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^FEUD(?:NN|ME)(?:064G|128G|256G|512G)[0-9A-Z]{5,}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "FEUD"
      ],
      "tables": {
        "seriesObj": {
          "NN": {
            "product_family": "Commercial UFS",
            "product_class": "Commercial",
            "operation_temperature": "-25°C ~ +85°C"
          },
          "ME": {
            "product_family": "Automotive UFS",
            "product_class": "Automotive",
            "operation_temperature": "-40°C ~ +105°C"
          }
        },
        "packageBySeries": {
          "NN": "FBGA-153, 11.5x13x1.0",
          "ME": "FBGA-153, 11.5x13x1.2"
        },
        "packageSpecific": {
          "064G:C2A46": "FBGA-153, 11.5x13x0.8",
          "128G:C2A44": "FBGA-153, 11.5x13x0.8",
          "256G:C2A44": "FBGA-153, 11.5x13x1.0"
        },
        "densityCode": [
          "064G",
          "128G",
          "256G",
          "512G"
        ],
        "density": {
          "064G": 524288,
          "128G": 1048576,
          "256G": 2097152,
          "512G": 4194304
        },
        "configCode": [
          "C2A56",
          "C2H14",
          "C2A44",
          "C2A46",
          "C2G07",
          "B8A19",
          "C8H09"
        ],
        "configObj": {
          "C2A56": {
            "storage_interface": "UFS 2.2",
            "nand_technology": "3D NAND"
          },
          "C2H14": {
            "storage_interface": "UFS 2.2",
            "nand_technology": "3D NAND"
          },
          "C2A44": {
            "storage_interface": "UFS 2.2",
            "speed_grade": "HS-Gear3 2L",
            "nand_technology": "3D TLC"
          },
          "C2A46": {
            "storage_interface": "UFS 2.2",
            "speed_grade": "HS-Gear3 2L",
            "nand_technology": "3D TLC"
          },
          "C2G07": {
            "storage_interface": "UFS 2.2",
            "speed_grade": "UFS 2.2 HS-Gear3",
            "nand_technology": "TLC"
          },
          "B8A19": {
            "storage_interface": "UFS 2.1",
            "speed_grade": "Gear3 2L",
            "nand_technology": "3D NAND"
          },
          "C8H09": {
            "storage_interface": "UFS 3.1",
            "speed_grade": "Gear4 2L",
            "nand_technology": "3D NAND"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 2,
          "to": "seriesCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "seriesObj",
          "to": "seriesObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "packageBySeries",
          "to": "packageBase",
          "default": "FBGA-153"
        },
        {
          "op": "takeLongest",
          "table": "densityCode",
          "to": "densityCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "takeLongest",
          "table": "configCode",
          "to": "configCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "configObj",
          "to": "configObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{densityCode}}:{{configCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageSpecific",
          "to": "packageSpecific",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "packageSpecific",
          "secondary": "packageBase",
          "to": "package"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "series_code": {
              "$var": "seriesCode"
            },
            "density_code": {
              "$var": "densityCode"
            },
            "config_code": {
              "$var": "configCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "seriesObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "configObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code",
            "config_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "longsys",
        "device.chipKind": "managed_nand",
        "device.productType": "ufs",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": 3,
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.longsys.foresee.ufs.v1"
      }
    }
  }
]
