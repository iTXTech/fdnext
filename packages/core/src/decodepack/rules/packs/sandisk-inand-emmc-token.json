[
  {
    "id": "vendor.sndk.inand.emmc.v1",
    "priority": 1007,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^SDIN(?:ADF4|BDA4|BDA6|BDG4|BDV4)-?(?:00[48]G|0(?:16|32|64)G|4G|8G|16G|32G|64G|128G|256G)(?:-[0-9A-Z]+)?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "SDIN"
      ],
      "tables": {
        "familyObj": {
          "ADF4": {
            "product_family": "iNAND MC EM111",
            "group": "eMMC",
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400"
          },
          "BDA4": {
            "product_family": "iNAND MC EM131",
            "group": "eMMC",
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400"
          },
          "BDA6": {
            "product_family": "iNAND IX EM132",
            "group": "eMMC",
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400",
            "nand_technology": "BiCS3 64L 3D NAND",
            "generation_info": "BiCS3 64L 3D NAND",
            "component_voltage": "VCC 2.7-3.6V / VCCQ 1.7-1.95V or 2.7-3.6V"
          },
          "BDG4": {
            "product_family": "iNAND 7250 / EM122-class",
            "group": "eMMC",
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400",
            "nand_technology": "2D NAND",
            "generation_info": "2D NAND"
          },
          "BDV4": {
            "product_family": "iNAND MC EM141",
            "group": "eMMC",
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400"
          }
        },
        "processNode": {
          "BDA6": "SBiCS3"
        },
        "density": {
          "4G": 32768,
          "004G": 32768,
          "8G": 65536,
          "008G": 65536,
          "16G": 131072,
          "016G": 131072,
          "32G": 262144,
          "032G": 262144,
          "64G": 524288,
          "064G": 524288,
          "128G": 1048576,
          "256G": 2097152
        },
        "suffixObj": {
          "H": {
            "product_class": "Connected Home",
            "operation_temperature": "-25°C ~ 95°C"
          },
          "I1": {
            "product_class": "Industrial Wide Temperature",
            "operation_temperature": "-25°C ~ 85°C"
          },
          "I2": {
            "product_class": "Industrial Wide Temperature",
            "operation_temperature": "-25°C ~ 85°C"
          },
          "XI1": {
            "product_class": "Industrial Extended Temperature",
            "operation_temperature": "-40°C ~ 85°C"
          },
          "XI2": {
            "product_class": "Industrial Extended Temperature",
            "operation_temperature": "-40°C ~ 85°C"
          },
          "XA1": {
            "product_class": "Automotive",
            "operation_temperature": "-40°C ~ 85°C"
          },
          "XA3": {
            "product_class": "Automotive",
            "operation_temperature": "-40°C ~ 85°C"
          },
          "ZA": {
            "product_class": "Automotive",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "ZA1": {
            "product_class": "Automotive",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "ZA3": {
            "product_class": "Automotive",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "DG": {
            "product_class": "Engineering / DG"
          },
          "QUAL": {
            "product_class": "Qualification Sample"
          }
        },
        "reference": {
          "BDA6": {
            "status": "external_confirmed",
            "source": "Sandisk iNAND IX EM132 product brief and automotive brochure",
            "examples": [
              "SDINBDA6-256G-XI1",
              "SDINBDA6-##G-ZA1"
            ]
          },
          "BDG4": {
            "status": "external_confirmed",
            "source": "Western Digital mobile brochure and Sandisk automotive brochure",
            "examples": [
              "SDINBDG4-32G",
              "SDINBDG4-##G-ZA3"
            ]
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 4,
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "processNode",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "map",
          "from": "processNode",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "suffixObj",
          "to": "suffixObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "iNAND"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "suffixObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "sndk",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "meta.nandDieProfileKey": {
          "$var": "processNode"
        },
        "meta.ruleId": "vendor.sndk.inand.emmc.v1",
        "fields.layer_count": {
          "$path": "processObj.layer_count"
        },
        "fields.die_codename": {
          "$var": "processNode"
        }
      }
    }
  }
]
