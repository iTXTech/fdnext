[
  {
    "id": "vendor.sndk.inand.legacy-emmc.v1",
    "priority": 1006,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^SDIN(?:5C2|5C4)-?(?:00[48]G|0(?:16|32|64)G|4G|8G|16G|32G|64G|128G)(?:[-_][0-9A-Z]+)?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "SDIN"
      ],
      "tables": {
        "familyObj": {
          "5C2": {
            "product_family": "iNAND legacy eMMC",
            "storage_interface": "eMMC 4.41"
          },
          "5C4": {
            "product_family": "iNAND legacy eMMC",
            "storage_interface": "eMMC 4.41"
          }
        },
        "processNode": {
          "5C2": "SNK24M",
          "5C4": "SNK24M"
        },
        "density": {
          "4G": 32768,
          "004G": 32768,
          "8G": 65536,
          "008G": 65536,
          "16G": 131072,
          "016G": 131072,
          "32G": 262144,
          "032G": 262144,
          "64G": 524288,
          "064G": 524288,
          "128G": 1048576,
          "256G": 2097152,
          "512G": 4194304,
          "1T00": 8388608
        },
        "packageByFamilyDensity": {
          "5C2:32G": "BGA-169, 12x16",
          "5C4:32G": "BGA-169, 12x16",
          "5C4:64G": "BGA-169, 12x16"
        },
        "suffixObj": {
          "Q": {
            "prod_status": "Engineering Sample"
          }
        }
      },
      "steps": [
        {
          "op": "takeRegex",
          "pattern": "^(?:5C2|5C4)",
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "processNode",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "keyTo": "densityCode",
          "default": 0
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{densityCode}}",
          "to": "familyDensityKey"
        },
        {
          "op": "map",
          "from": "familyDensityKey",
          "table": "packageByFamilyDensity",
          "to": "package"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "_"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9A-Z]+",
          "to": "suffix",
          "default": ""
        },
        {
          "op": "map",
          "from": "suffix",
          "table": "suffixObj",
          "to": "suffixObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "iNAND"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "suffixObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "sndk",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.nandDieProfileKey": {
          "$var": "processNode"
        },
        "meta.ruleId": "vendor.sndk.inand.legacy-emmc.v1",
        "fields.die_codename": {
          "$var": "processNode"
        }
      }
    }
  }
]
