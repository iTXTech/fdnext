[
  {
    "id": "vendor.longsys.foresee.emmc.v1",
    "priority": 1001,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^FEM(?:DME|DRM|DRW|DMW|DNN|KNN|JNM)(?:004G|008G|016G|032G|064G|0128G|128G|256G)[0-9A-Z]{5,}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "FEM"
      ],
      "tables": {
        "seriesObj": {
          "DME": {
            "product_family": "Automotive eMMC Grade2",
            "product_class": "Automotive AEC-Q100 Grade 2",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-40°C ~ +105°C"
          },
          "DRM": {
            "product_family": "Industrial eMMC",
            "product_class": "Industrial",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-25°C ~ +85°C"
          },
          "DRW": {
            "product_family": "Industrial Wide-temperature eMMC",
            "product_class": "Industrial Wide Temperature",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-40°C ~ +85°C"
          },
          "DMW": {
            "product_family": "Automotive eMMC Grade3",
            "product_class": "Automotive AEC-Q100 Grade 3",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-40°C ~ +85°C"
          },
          "DNN": {
            "product_family": "Commercial eMMC",
            "product_class": "Commercial",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-25°C ~ +85°C",
            "nand_technology": "3D TLC"
          },
          "KNN": {
            "product_family": "Commercial Subsize eMMC",
            "product_class": "Commercial Subsize",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-25°C ~ +85°C",
            "nand_technology": "MLC"
          },
          "JNM": {
            "product_family": "Commercial Subsize eMMC",
            "product_class": "Commercial Subsize",
            "storage_interface": "eMMC 5.1",
            "operation_temperature": "-25°C ~ +85°C",
            "nand_technology": "TLC"
          }
        },
        "packageBase": {
          "DME": "FBGA-153, 11.5x13x1.0",
          "DRM": "FBGA-153, 11.5x13x1.0",
          "DRW": "FBGA-153, 11.5x13x1.0",
          "DMW": "FBGA-153, 11.5x13x1.0",
          "DNN": "FBGA-153",
          "KNN": "FBGA-153, 9x7.5x0.8",
          "JNM": "FBGA-153, 9x10x0.8"
        },
        "packageSpecific": {
          "DME:004G": "FBGA-153, 11.5x13x1.0",
          "DME:008G": "FBGA-153, 11.5x13x1.0",
          "DME:016G": "FBGA-153, 11.5x13x1.0",
          "DME:032G": "FBGA-153, 11.5x13x1.0",
          "DME:064G": "FBGA-153, 11.5x13x1.2",
          "DNN:064G": "FBGA-153, 11.5x13x0.8",
          "DNN:128G": "FBGA-153, 11.5x13x0.8",
          "DNN:256G": "FBGA-153, 11.5x13x1.0",
          "KNN:004G": "FBGA-153, 9x7.5x0.8",
          "KNN:008G": "FBGA-153, 9x7.5x0.8",
          "JNM:032G": "FBGA-153, 9x10x0.8"
        },
        "densityCode": [
          "004G",
          "008G",
          "016G",
          "032G",
          "064G",
          "0128G",
          "128G",
          "256G"
        ],
        "density": {
          "004G": 32768,
          "008G": 65536,
          "016G": 131072,
          "032G": 262144,
          "064G": 524288,
          "0128G": 1048576,
          "128G": 1048576,
          "256G": 2097152
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "seriesCode"
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "seriesObj",
          "to": "seriesObj",
          "default": {
            "storage_interface": "eMMC 5.1"
          }
        },
        {
          "op": "map",
          "from": "seriesCode",
          "table": "packageBase",
          "to": "packageBase",
          "default": "FBGA153"
        },
        {
          "op": "takeLongest",
          "table": "densityCode",
          "to": "densityCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "tpl",
          "template": "{{seriesCode}}:{{densityCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageSpecific",
          "to": "packageSpecific",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "packageSpecific",
          "secondary": "packageBase",
          "to": "package"
        },
        {
          "op": "take",
          "len": 5,
          "to": "configCode"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "series_code": {
              "$var": "seriesCode"
            },
            "density_code": {
              "$var": "densityCode"
            },
            "config_code": {
              "$var": "configCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "seriesObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code",
            "config_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "longsys",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.longsys.foresee.emmc.v1"
      }
    }
  }
]
