        "fields.nand_technology": "3D TLC",
        "fields.cell_level": 3,
        "fields.speed_grade": "2150 MB/s read / 1650 MB/s write",
        "fields.operation_temperature": "-40°C ~ +105°C",
        "fields.package": "FBGA-153, 11.50x13.00x1.20",
        "meta.ruleId": "vendor.biwin.ufs31.automotive.v1",
        "meta.fieldProfile": "managed_nand",
        "meta.capabilities": ["part.decode", "part.search"]
      }
    }
  }
