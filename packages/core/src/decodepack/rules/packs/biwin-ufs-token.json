[
  {
    "id": "vendor.biwin.ufs.v1",
    "priority": 1001,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^BWU2A(?:0516B|0526B|0546B|NY46B)(?:064G|128G|256G|512G)$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "BWU2A"
      ],
      "tables": {
        "configCode": [
          "0516B",
          "0526B",
          "0546B",
          "NY46B"
        ],
        "densityCode": [
          "064G",
          "128G",
          "256G",
          "512G"
        ],
        "density": {
          "064G": 524288,
          "128G": 1048576,
          "256G": 2097152,
          "512G": 4194304
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "configCode",
          "to": "configCode",
          "default": ""
        },
        {
          "op": "takeLongest",
          "table": "densityCode",
          "to": "densityCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "product_class": "Consumer",
            "storage_interface": "UFS 2.2",
            "speed_grade": "1000 MB/s read / 800 MB/s write",
            "config_code": {
              "$var": "configCode"
            },
            "operation_temperature": "-25°C ~ +85°C"
          }
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "config_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "biwin",
        "device.chipKind": "managed_nand",
        "device.productType": "ufs",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.package": "FBGA-153, 11.50x13.00",
        "meta.ruleId": "vendor.biwin.ufs.v1"
      }
    }
  },
  {
    "id": "vendor.biwin.ufs31.v1",
    "priority": 1002,
    "normalize": ["trim", "uppercase", { "remove": [" ", ",", "&", ".", "|", "-"] }],
    "match": { "kind": "regex", "value": "^BWU3A(?:KG16D|KG26D|KG46D)(?:128G|256G|512G)$" },
    "tokenDecoder": {
      "stripPrefixes": ["BWU3A"],
      "tables": {
        "configCode": ["KG16D", "KG26D", "KG46D"],
        "densityCode": ["128G", "256G", "512G"],
        "density": { "128G": 1048576, "256G": 2097152, "512G": 4194304 }
      },
      "steps": [
        { "op": "takeLongest", "table": "configCode", "to": "configCode", "default": "" },
        { "op": "takeLongest", "table": "densityCode", "to": "densityCode", "default": "" },
        { "op": "map", "from": "densityCode", "table": "density", "to": "density", "default": 0 }
      ],
      "assign": {
        "device.partNumber": { "$var": "partNumber" },
        "device.domain": "memory",
        "device.vendor": "biwin",
        "device.chipKind": "managed_nand",
        "device.productType": "ufs",
        "fields.density": { "$var": "density" },
        "fields.storage_interface": "UFS 3.1",
        "fields.product_class": "Consumer",
        "fields.speed_grade": "2100 MB/s read / 1800 MB/s write",
        "fields.operation_temperature": "-25°C ~ +85°C",
        "fields.package": "FBGA-153, 11.50x13.00",
        "meta.ruleId": "vendor.biwin.ufs31.v1",
        "meta.fieldProfile": "managed_nand",
        "meta.capabilities": ["part.decode", "part.search"]
      }
    }
  },
  {
    "id": "vendor.biwin.ufs31.automotive.v1",
    "priority": 1002,
    "normalize": ["trim", "uppercase", { "remove": [" ", ",", "&", ".", "|", "-"] }],
    "match": { "kind": "regex", "value": "^TCUFMA(?:128G|256G|512G)NAC8$" },
    "tokenDecoder": {
      "stripPrefixes": ["TCUFMA"],
      "tables": {
        "densityCode": ["128G", "256G", "512G"],
        "density": { "128G": 1048576, "256G": 2097152, "512G": 4194304 }
      },
      "steps": [
        { "op": "takeLongest", "table": "densityCode", "to": "densityCode", "default": "" },
        { "op": "take", "len": 4, "to": "configCode" },
        { "op": "map", "from": "densityCode", "table": "density", "to": "density", "default": 0 }
      ],
      "assign": {
