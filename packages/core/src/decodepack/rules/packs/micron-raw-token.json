        {
          "op": "take",
          "len": 6,
          "to": "orderingBody"
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageToken"
        },
        {
          "op": "tpl",
          "template": "{{productFamilyToken}}:{{packageToken}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageObj",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9]{2}",
          "to": "speedToken",
          "default": ""
        },
        {
          "op": "map",
          "from": "speedToken",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "takeLongest",
