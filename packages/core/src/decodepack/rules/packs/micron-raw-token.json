          "value": {
            "product_family": "Micron ClearNAND",
            "storage_interface": "Parallel NAND",
            "cell_level": "MLC",
            "special_option": "Integrated error management"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productFamilyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "storageDensityObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "speedObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productionStatusObj"
        }
      ],
      "assign": {
