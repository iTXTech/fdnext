          "umcp": "umcp",
          "e2nand": "e2nand"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "enterprise_token"
        },
        {
          "op": "map",
          "from": "enterprise_token",
          "table": "enterprise_flag",
          "to": "enterprise",
          "default": false
        },
        {
          "op": "map",
          "from": "enterprise_token",
          "table": "mt29fb_marker_prefix",
          "to": "canStripMt29fbMarker",
          "default": false
        },
        {
          "op": "stripIfPrefix",
          "prefix": "B",
          "to": "mt29fbMarker",
          "if": "canStripMt29fbMarker"
        },
        {
          "op": "set",
          "to": "type",
          "value": "nand"
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": null
        },
        {
          "op": "take",
          "len": 2,
          "to": "device_token"
        },
        {
          "op": "map",
          "from": "device_token",
          "table": "device_width",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "cell_token"
        },
        {
          "op": "map",
          "from": "cell_token",
          "table": "cell_level",
          "to": "cellLevel",
          "default": null
        },
        {
          "op": "take",
          "len": 1,
          "to": "class_token"
        },
        {
          "op": "map",
          "from": "class_token",
          "table": "classification",
          "to": "classification",
          "default": {
            "ce": -1,
            "ch": -1,
            "rb": -1,
            "die": -1
          }
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltage_token"
        },
        {
          "op": "map",
          "from": "voltage_token",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "die_token"
        },
        {
          "op": "map",
          "from": "die_token",
          "table": "die_code",
          "to": "die_code",
          "default": "Unknown"
        },
        {
          "op": "set",
          "to": "dieCount",
          "value": {
            "$path": [
              "classification",
              "die"
            ]
          }
        },
        {
          "op": "dieDensity",
          "density": "density",
          "dieCount": "dieCount",
          "to": "dieDensityClass",
          "default": ""
        },
        {
          "op": "tpl",
          "template": "{{dieDensityClass}}:{{cellLevel}}:{{die_token}}",
          "to": "dieDensityCellRevKey"
        },
        {
          "op": "map",
          "from": "dieDensityCellRevKey",
          "table": "processNodeByDieDensityCellRev",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "map",
          "from": "processNode",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "interface_token"
        },
        {
          "op": "map",
          "from": "interface_token",
          "table": "interface",
          "to": "interface",
          "default": {
            "async": false,
            "sync": false
          }
        },
        {
          "op": "map",
          "from": "interface_token",
          "table": "interface_info",
          "to": "interface_type",
          "default": "Unknown"
        },
        {
          "op": "takeLongest",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9A-Z]+",
          "to": "suffixCode",
          "default": ""
        },
        {
          "op": "stripIfPrefix",
          "prefix": ":"
        },
        {
          "op": "takeRegex",
          "pattern": "^[0-9A-Z]+",
          "to": "revisionCode",
          "default": ""
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "enterprise": {
              "$var": "enterprise"
            },
            "die_code": {
              "$var": "die_code"
            },
            "interface_type": {
              "$var": "interface_type"
            }
          }
        },
        {
          "op": "map",
          "from": "type",
          "table": "draftChipKind",
          "to": "draftChipKind",
          "default": "raw_nand"
        },
        {
          "op": "map",
          "from": "type",
          "table": "draftProductType",
          "to": "draftProductType",
          "default": null
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "micron",
        "device.chipKind": {
          "$var": "draftChipKind"
        },
        "device.productType": {
          "$var": "draftProductType"
        },
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.device_width": {
          "$var": "deviceWidth"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.die_count": {
          "$path": [
            "classification",
            "die"
          ]
        },
        "fields.ce_count": {
          "$path": [
            "classification",
            "ce"
          ]
        },
        "fields.rb_count": {
          "$path": [
            "classification",
            "rb"
          ]
        },
        "fields.channel_count": {
          "$path": [
            "classification",
            "ch"
          ]
        },
        "fields.voltage": {
          "$var": "voltage"
        },
        "fields.package": {
          "$var": "package"
        },
        "fields.die_codename": {
          "$var": "processNode"
        },
        "fields.layer_count": {
          "$path": "processObj.layer_count"
        },
        "meta.ruleId": "vendor.micron.token.v1"
      }
    }
  }
]
