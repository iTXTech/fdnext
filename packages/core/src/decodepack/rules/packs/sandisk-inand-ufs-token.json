      "steps": [
        {
          "op": "take",
          "len": 4,
          "to": "familyCode"
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "familyCode",
          "table": "processNode",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "map",
          "from": "processNode",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "keyTo": "densityCode",
          "default": 0
        },
        {
          "op": "tpl",
          "template": "{{familyCode}}:{{densityCode}}",
          "to": "familyDensityKey"
        },
        {
          "op": "map",
          "from": "familyDensityKey",
          "table": "packageByFamilyDensity",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "suffixObj",
          "to": "suffixObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "iNAND"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "suffixObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
