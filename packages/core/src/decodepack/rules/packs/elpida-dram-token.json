        {
          "op": "map",
          "from": "packageKey",
          "table": "package",
          "to": "package",
          "keyTo": "recognizedPackageKey"
        },
        {
          "op": "notEmpty",
          "from": "recognizedPackageKey",
          "to": "hasKnownPackage"
        },
        {
          "op": "stripIfPrefix",
