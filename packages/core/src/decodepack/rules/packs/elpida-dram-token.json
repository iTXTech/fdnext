        },
        "fields.dram_speed": {
          "$path": "speedObj.dram_speed"
        },
        "fields.cs_count": {
          "$path": "configurationObj.cs_count"
        },
        "fields.channel_count": {
          "$path": "configurationObj.channel_count"
        },
        "fields.package": {
          "$var": "package"
        },
        "fields.special_option": {
          "$path": "typeObj.special_option"
        },
        "meta.ruleId": "vendor.elpida.dram.daisy_chain_mobile.v1",
        "meta.dramTopologyTokenRecognized": {
          "$var": "hasKnownPackage"
        },
        "meta.fieldProfile": "dram",
        "meta.capabilities": [
          "part.decode",
          "part.search"
        ]
      }
    }
  }
