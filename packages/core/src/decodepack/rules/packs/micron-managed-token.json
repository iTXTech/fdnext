      "steps": [
        {
          "op": "takeLongest",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 2,
          "to": "componentCode"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentType",
          "to": "componentType",
          "default": "emmc"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentObj",
          "to": "componentObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "controllerCode"
        },
        {
          "op": "map",
          "from": "controllerCode",
          "table": "controllerRevision",
          "to": "controllerObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{componentCode}}:{{controllerCode}}",
          "to": "familyKey"
        },
        {
          "op": "map",
          "from": "familyKey",
          "table": "familyType",
          "to": "familyType",
          "default": null
        },
        {
          "op": "fallback",
          "primary": "familyType",
          "secondary": "componentType",
          "to": "type"
        },
        {
          "op": "map",
          "from": "familyKey",
          "table": "familyObj",
          "to": "familyObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "specialOptionObj",
          "to": "specialOptionObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "temperatureObj",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "productionStatusObj",
          "to": "productionStatusObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "Micron managed NAND"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "componentObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "controllerObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "familyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "specialOptionObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productionStatusObj"
        },
        {
          "op": "map",
          "from": "type",
          "table": "draftChipKind",
          "to": "draftChipKind",
          "default": "raw_nand"
        },
        {
          "op": "map",
          "from": "type",
          "table": "draftProductType",
          "to": "draftProductType",
          "default": null
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "generation_code",
            "voltage_io_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "micron",
        "device.chipKind": {
          "$var": "draftChipKind"
        },
        "device.productType": {
          "$var": "draftProductType"
        },
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.micron.managed.mtfc.nextgen.v1"
