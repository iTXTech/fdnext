[
  {
    "id": "vendor.kingston.ufs.v1",
    "priority": 1002,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^UFS(?:64G|128|256)[0-9A-Z]{4}$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "UFS"
      ],
      "tables": {
        "reference": {
          "kingston_official_ufs_table": {
            "status": "external_table_confirmed",
            "source": "Kingston UFS Part Numbers and Specifications"
          }
        },
        "densityCode": [
          "128",
          "256",
          "64G"
        ],
        "density": {
          "128": 1048576,
          "256": 2097152,
          "64G": 524288
        },
        "package": {
          "128": "11x13x0.85",
          "256": "11x13x0.95",
          "64G": "11x13x0.85"
        },
        "configObj": {
          "CY14": {
            "config_code": "CY14",
            "storage_interface": "UFS 3.1",
            "speed_grade": "G4 4P",
            "nand_technology": "TLC",
            "package_code": "153B",
            "operation_temperature": "-25°C ~ +85°C"
          }
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "densityCode",
          "to": "densityCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "package",
          "to": "package"
        },
        {
          "op": "take",
          "len": 4,
          "to": "configCode"
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "configObj",
          "to": "configObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "config_code": {
              "$var": "configCode"
            }
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "configObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "config_code",
            "package_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "kingston",
        "device.chipKind": "managed_nand",
        "device.productType": "ufs",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": 3,
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.kingston.ufs.v1"
      }
    }
  }
]
