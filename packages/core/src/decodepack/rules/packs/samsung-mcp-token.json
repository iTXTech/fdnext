          "template": "{{capacityToken}}:{{ramToken}}",
          "to": "dramDensityKey"
        },
        {
          "op": "tpl",
          "template": "{{typePackageKey}}:{{capacityToken}}",
          "to": "typePackageCapacityKey"
        },
        {
          "op": "map",
          "from": "typeToken",
          "table": "typeInfo",
          "to": "typeInfo",
          "default": {}
        },
        {
          "op": "map",
          "from": "typeToken",
          "table": "productType",
          "to": "productType"
        },
        {
          "op": "map",
          "from": "typeToken",
          "table": "storageTransport",
          "to": "storageTransport"
        },
        {
          "op": "map",
          "from": "typeSpeedKey",
          "table": "interfaceByTypeSpeed",
          "to": "storageInterface"
        },
        {
          "op": "map",
          "from": "capacityToken",
          "table": "capacityMbit",
          "to": "densityByCapacity"
        },
        {
          "op": "map",
          "from": "typePackageCapacityKey",
          "table": "capacityMbitByTypePackage",
          "to": "densityByTypePackage"
        },
        {
          "op": "fallback",
          "primary": "densityByTypePackage",
          "secondary": "densityByCapacity",
          "to": "density"
        },
        {
          "op": "tpl",
          "template": "{{capacityToken}}:{{storageTransport}}",
          "to": "storageDensityKey"
        },
        {
          "op": "map",
          "from": "storageDensityKey",
          "table": "storageDensity",
          "to": "storageDensityByCapacity"
        },
        {
          "op": "map",
