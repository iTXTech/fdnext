          "to": "tailToken"
        },
        {
          "op": "tpl",
          "template": "{{typeToken}}:{{speedToken}}",
          "to": "typeSpeedKey"
        },
        {
          "op": "tpl",
          "template": "{{typeToken}}:{{packageToken}}",
