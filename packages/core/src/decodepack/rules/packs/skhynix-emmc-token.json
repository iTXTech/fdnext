[
  {
    "id": "vendor.skhynix.emmc.managed.v1",
    "priority": 1005,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^H26[MT][0-9A-Z]{8}(?:[A-Z])?$"
    },
    "tokenDecoder": {
      "tables": {
        "density": {
          "3": 32768,
          "4": 65536,
          "5": 131072,
          "6": 262144,
          "7": 524288,
          "8": 1048576
        },
        "mediaObj": {
          "M": {
            "managed_family": "e-NAND"
          },
          "T": {
            "managed_family": "e-NAND"
          }
        },
        "componentObj": {
          "1001": {
            "product_version": "eMMC 4.5",
            "storage_interface": "eMMC 4.5",
            "generation_info": "1xnm NAND",
            "die_density": "32Gb",
            "die_count": 1
          },
          "1002": {
            "generation_info": "3D-V2 NAND",
            "die_density": "128Gb",
            "die_count": 1
          },
          "1204": {
            "generation_info": "1xnm NAND",
            "die_density": "64Gb",
            "die_count": 1
          },
          "1208": {
            "generation_info": "1xnm NAND",
            "die_density": "64Gb",
            "die_count": 1
          },
          "2002": {
            "generation_info": "3D-V2 NAND",
            "die_density": "128Gb",
            "die_count": 2
          },
          "2208": {
            "generation_info": "1xnm NAND",
            "die_density": "64Gb",
            "die_count": 2
          },
          "4002": {
            "generation_info": "3D-V2 NAND",
            "die_density": "128Gb",
            "die_count": 4
          },
          "4208": {
            "generation_info": "1xnm NAND",
            "die_density": "64Gb",
            "die_count": 4
          },
          "8002": {
            "generation_info": "3D-V2 NAND",
            "die_density": "128Gb",
            "die_count": 8
          },
          "8208": {
            "generation_info": "1xnm NAND",
            "die_density": "64Gb",
            "die_count": 8
          }
        },
        "package": {
          "HPR": "FBGA-153, 11.5x13x0.8",
          "FPR": "FBGA-153, 11.5x13x0.8",
          "GPR": "FBGA-153, 11.5x13x0.8",
          "KPR": "FBGA-153, 11.5x13x0.8",
          "JPR": "FBGA-153, 11.5x13x0.8",
          "AMR": "FBGA-153, 11.5x13x1.0",
          "CMR": "FBGA-153, 11.5x13x1.0",
          "EMR": "FBGA-153, 11.5x13x1.0",
          "HMR": "FBGA-153, 11.5x13x1.0"
        },
        "gradeObj": {
          "A": {
            "product_class": "Automotive AIT",
            "operation_temperature": "-40°C ~ 85°C"
          },
          "I": {
            "product_class": "Industrial",
            "operation_temperature": "-40°C ~ 85°C"
          },
          "N": {
            "product_class": "Commercial CT",
            "operation_temperature": "-25°C ~ 85°C"
          },
          "X": {
            "product_class": "Automotive Grade 2/3",
            "operation_temperature": "-40°C ~ 105°C"
          },
          "Q": {
            "product_class": "Automotive AAT",
            "operation_temperature": "-40°C ~ 105°C"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 3,
          "to": "skipPrefix"
        },
        {
          "op": "take",
          "len": 1,
          "to": "mediaCode"
        },
        {
          "op": "map",
          "from": "mediaCode",
          "table": "mediaObj",
          "to": "mediaObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 4,
          "to": "componentCode"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentObj",
          "to": "componentObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 3,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package",
          "default": "FBGA-153"
        },
        {
          "op": "takeLongest",
          "table": "gradeObj",
          "to": "gradeObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "system": "SK hynix e-NAND",
            "group": "eMMC",
            "product_version": "eMMC 5.1",
            "storage_interface": "eMMC 5.1",
            "interface_type": "HS400+CMD Q"
          }
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "mediaObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "componentObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "gradeObj"
        },
        {
          "op": "omit",
          "from": "extra",
          "keys": [
            "system",
            "group",
            "series_code",
            "cell_code",
            "layout_code",
            "density_code",
            "stack_code",
            "component_code",
            "generation_code",
            "voltage_io_code",
            "package_code"
          ]
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "skhynix",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.voltage": "VCC: 3.3V, VCCQ: 1.8V",
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.skhynix.emmc.managed.v1"
      }
    }
  }
]
