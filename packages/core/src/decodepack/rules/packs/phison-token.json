[
  {
    "id": "vendor.phison.token.v1",
    "priority": 940,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^[ATIKHDCNS][APCOKFTBYUGJ][135678ABC](?:0G|1G|2G|3G|4G|5G|6G|7G|8G|9G|AG|BG|EG|HG|IG|JG)[0-9A-Z]{5}$"
    },
    "tokenDecoder": {
      "tables": {
        "originalVendor": {
          "T": "kioxia",
          "I": "micron",
          "K": "micron",
          "H": "skhynix",
          "D": "sndk",
          "C": "ymtc",
          "N": "intel",
          "S": "samsung"
        },
        "package": {
          "A": "BGA132",
          "P": "BGA152",
          "C": "BGA272",
          "O": "LGA60-SAT",
          "K": "LGA60-SAT",
          "F": "TSOP48",
          "T": "TSOP48",
          "B": "BGA132 / LGA110",
          "Y": "BGA56-UFS"
        },
        "ce": {
          "1": 1,
          "3": 2,
          "5": 2,
          "6": 2,
          "7": 4,
          "8": 4,
          "A": 4,
          "B": 8,
          "C": 8
        },
        "die": {
          "1": 1,
          "3": 2,
          "5": 2,
          "6": 4,
          "7": 4,
          "8": 8,
          "A": 16,
          "B": 8,
          "C": 16
        },
        "density": {
          "0G": 1024,
          "1G": 2048,
          "2G": 4096,
          "3G": 8192,
          "4G": 16384,
          "5G": 32768,
          "6G": 65536,
          "7G": 131072,
          "8G": 262144,
          "9G": 524288,
          "AG": 1048576,
          "BG": 2097152,
          "EG": 3145728,
          "HG": 4194304,
          "IG": 8388608,
          "JG": 16777216
        },
        "nodeVendorOverride": {
          "micron": "intel"
        },
        "processNode": {
          "kioxia:H": "TSBD2H",
          "kioxia:P": "TSBDFK",
          "kioxia:R": "TSB15T",
          "kioxia:S": "TSB15M2P",
          "kioxia:U": "TSB15M4P",
          "kioxia:V": "KBiCS2",
          "kioxia:I": "KBiCS3",
          "kioxia:W": "KBiCS4",
          "kioxia:X": "KBiCS4.5",
          "kioxia:Y": "KBiCS5",
          "sndk:H": "SNK24M",
          "sndk:L": "SNK19M",
          "sndk:R": "SNK15T",
          "sndk:S": "SNK15M2P",
          "sndk:U": "SNK15M4P",
          "sndk:V": "SBiCS2",
          "sndk:I": "SBiCS3",
          "sndk:W": "SBiCS4",
          "sndk:X": "SBiCS4.5",
          "sndk:Y": "SBiCS5",
          "intel:N": "L85A",
          "intel:P": "L95B",
          "intel:V": "B27A",
          "intel:I": "B27B",
          "intel:X": "B37R",
          "intel:Y": "B47R",
          "intel:W": "N28A",
          "skhynix:P": "HY16",
          "skhynix:O": "HYV4",
          "skhynix:V": "HYV5",
          "ymtc:O": "JGS"
        },
        "cellLevel": {
          "kioxia:H": 2,
          "kioxia:P": 2,
          "kioxia:R": 3,
          "kioxia:S": 2,
          "kioxia:U": 2,
          "kioxia:V": 3,
          "kioxia:I": 3,
          "kioxia:W": 3,
          "kioxia:X": 3,
          "kioxia:Y": 3,
          "intel:N": 2,
          "intel:P": 2,
          "intel:O": -1,
          "intel:V": 3,
          "intel:I": 3,
          "intel:X": 3,
          "intel:Y": 3,
          "intel:W": 4,
          "kioxia:L": 2,
          "skhynix:P": 3,
          "skhynix:O": 3,
          "skhynix:R": 3,
          "skhynix:V": 3,
          "ymtc:O": 3
        },
        "cellCodeLevel": {
          "2": 3,
          "3": 3,
          "4": 3,
          "5": 3,
          "7": 4,
          "B": 1,
          "F": 2,
          "G": 2,
          "I": 1,
          "K": 3,
          "L": 2,
          "M": 3,
          "N": 2,
          "O": 2,
          "Q": 2,
          "R": 1,
          "S": 2,
          "U": 2,
          "V": 3,
          "W": 2
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "vendorCode"
        },
        {
          "op": "map",
          "from": "vendorCode",
          "table": "originalVendor",
          "to": "originalVendor",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "classCode"
        },
        {
          "op": "map",
          "from": "classCode",
          "table": "ce",
          "to": "ce",
          "default": -1
        },
        {
          "op": "map",
          "from": "classCode",
          "table": "die",
          "to": "die",
          "default": -1
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "featureCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "cellCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "optionCode"
        },
        {
          "op": "take",
          "len": 1,
          "to": "nodeCode"
        },
        {
          "op": "map",
          "from": "originalVendor",
          "table": "nodeVendorOverride",
          "to": "nodeVendorOverride",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "nodeVendorOverride",
          "secondary": "originalVendor",
          "to": "nodeVendor"
        },
        {
          "op": "tpl",
          "template": "{{nodeVendor}}:{{nodeCode}}",
          "to": "nodeKey"
        },
        {
          "op": "map",
          "from": "nodeKey",
          "table": "processNode",
          "to": "processNode",
          "default": ""
        },
        {
          "op": "map",
          "from": "nodeKey",
          "table": "cellLevel",
          "to": "nodeCellLevel",
          "default": -1
        },
        {
          "op": "map",
          "from": "cellCode",
          "table": "cellCodeLevel",
          "to": "cellCodeLevel",
          "default": ""
        },
        {
          "op": "fallback",
          "primary": "cellCodeLevel",
          "secondary": "nodeCellLevel",
          "to": "cellLevel"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "phison",
        "device.chipKind": "raw_nand",
        "fields": {
          "original_vendor": {
            "$var": "originalVendor"
          }
        },
        "fields.package": {
          "$var": "package"
        },
        "fields.device_width": 8,
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.die_count": {
          "$var": "die"
        },
        "fields.ce_count": {
          "$var": "ce"
        },
        "meta.ruleId": "vendor.phison.token.v1",
        "fields.die_codename": {
          "$var": "processNode"
        }
      }
    }
  }
]
