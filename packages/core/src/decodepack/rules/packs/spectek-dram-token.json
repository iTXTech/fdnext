        "device.chipKind": "dram",
        "fields": {
          "$var": "extra"
        },
        "fields.dram_density": {
          "$var": "density"
        },
        "fields.dram_width": {
          "$var": "deviceWidth"
        },
        "fields.dram_voltage": {
          "$var": "voltage"
