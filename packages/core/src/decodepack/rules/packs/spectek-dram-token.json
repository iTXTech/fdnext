      "steps": [
        {
          "op": "takeLongest",
          "table": "prefixToken",
          "to": "markCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "markCode",
          "table": "prefixObj",
          "to": "prefixObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "configToken",
          "to": "configCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "configCode",
          "table": "deviceWidth",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "takeLongest",
          "table": "dramTypeObj",
          "to": "dramTypeObj",
          "default": {}
        },
        {
          "op": "takeRegex",
          "pattern": "^([0-9A-Z]{3})([0-9A-Z])([0-9A-Z])",
          "to": "body",
          "groups": {
            "designId": 1,
            "voltageCode": 2,
            "refreshCode": 3
          }
        },
        {
          "op": "map",
          "from": "voltageCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "refreshCode",
          "table": "featureObj",
          "to": "featureObj",
          "default": {}
        },
        {
          "op": "tpl",
          "template": "{{markCode}}:{{refreshCode}}",
          "to": "prefixFeatureKey"
        },
        {
          "op": "map",
          "from": "prefixFeatureKey",
          "table": "prefixFeatureObj",
          "to": "prefixFeatureObj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "packageToken",
          "to": "packageCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "packageObj",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeLongest",
          "table": "speedToken",
          "to": "speedCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "speedCode",
          "table": "speedObj",
          "to": "speedObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {}
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "prefixObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "dramTypeObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "featureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "prefixFeatureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "speedObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
