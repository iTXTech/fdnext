          "op": "map",
          "from": "chip_count_code",
          "table": "chip_count_obj",
          "to": "chip_count_obj",
          "default": {}
        },
        {
          "op": "takeLongest",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "takeRegex",
          "pattern": "^((?:046|053|062|075|083|093|107|125|15E|18|25|5|6)?)(BT|FT|MB|PG|UT)$",
          "to": "speed_grade_code",
          "default": "",
