[
  {
    "id": "vendor.samsung.token.v1",
    "priority": 950,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "prefix",
      "value": "K9"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "K9"
      ],
      "tables": {
