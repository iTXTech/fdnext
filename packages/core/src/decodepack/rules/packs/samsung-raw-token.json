          "AG": 16384,
          "BG": 32768,
          "CG": 65536,
          "DG": 131072,
          "EG": 262144,
          "FG": 262144,
          "GG": 393216,
          "HG": 524288,
          "LG": 24576,
          "NG": 98304,
          "ZG": 49152,
          "PG": 175104,
          "QG": 349184,
          "RG": 699392,
          "SG": 1397760,
          "KG": 1048576,
          "MG": 2097152,
          "UG": 4194304,
          "VG": 8388608,
          "YG": 16777216,
