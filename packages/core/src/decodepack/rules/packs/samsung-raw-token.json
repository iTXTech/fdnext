          "1:3:HG:B": "SSV6",
          "1:3:HG:E": "SSV6P",
          "1:3:HG:D": "SSV7",
          "1:3:HG:F": "SSV8"
        },
        "packageProfile": {
          "9:UG:C": "SSV7Q",
          "D:VG:E": "SSV6P",
          "D:YG:B": "SSV8",
          "D:YG:D": "SSV9",
          "X:VG:A": "SSV5Q",
          "X:VG:C": "SSV7Q",
          "X:VG:D": "SSV9Q",
          "X:VG:M": "SSV4Q"
        },
        "package": {
          "1": "BGA108",
          "8": "TSOP1",
          "9": "56-TSOP1",
          "A": "COB",
          "B": "FBGA",
          "C": "BGA316",
          "D": "BGA316",
          "E": "ISM",
          "F": "WSOP",
          "G": "FBGA",
          "H": "BGA132 or 136",
          "I": "ULGA (12*17)",
          "J": "FBGA",
          "K": "ULGA (12*17)",
          "L": "ULGA (14*18)",
          "M": "ULGA52 (13*18)",
          "P": "TSOP1",
          "Q": "TSOP2",
          "R": "56-TSOP1",
          "S": "TSOP1",
          "T": "WSOP",
          "U": "COB (MMC)",
          "V": "WSOP",
          "W": "Wafer",
          "Y": "TSOP1",
          "Z": "WELP",
          "X": "BGA108"
        },
        "lead_free": {
          "8": true,
          "9": true,
          "B": true,
          "E": true,
          "F": true,
          "I": true,
          "J": true,
          "K": true,
          "L": true,
          "M": true,
          "P": true,
          "Q": true,
          "R": true,
          "S": true,
          "T": true,
          "Z": true
        },
        "halogen_free": {
          "8": true,
          "9": true,
          "B": true,
          "E": true,
          "K": true,
          "L": true,
          "M": true,
          "R": true,
          "S": true,
          "T": true
        },
        "cu": {
          "8": true,
          "9": true
        },
        "operation_temperature": {
          "0": "samsung_none",
          "C": "samsung_temp_c",
          "S": "samsung_temp_s",
          "B": "samsung_temp_b",
          "I": "samsung_temp_i"
        },
        "bad_block": {
          "0": "samsung_none",
          "B": "samsung_cbb_b",
          "D": "samsung_cbb_d",
          "K": "samsung_cbb_k",
          "L": "samsung_cbb_l",
          "N": "samsung_cbb_n",
          "S": "samsung_cbb_s"
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 1,
          "to": "classificationCode"
        },
        {
          "op": "map",
          "from": "classificationCode",
          "table": "cellLevel",
          "to": "cellLevel",
          "default": -1
        },
        {
          "op": "map",
          "from": "classificationCode",
          "table": "die",
          "to": "die",
          "default": -1
        },
        {
          "op": "take",
          "len": 2,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "technology"
        },
        {
          "op": "map",
          "from": "technology",
          "table": "toggleVer",
          "to": "toggleVer",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "technology",
          "table": "toggleFlag",
          "to": "toggleFlag",
          "default": false
        },
        {
          "op": "take",
          "len": 1,
          "to": "widthCode"
        },
        {
          "op": "map",
          "from": "widthCode",
          "table": "deviceWidth",
          "to": "deviceWidth",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "voltageCode"
        },
        {
          "op": "map",
          "from": "voltageCode",
          "table": "voltage",
          "to": "voltage",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "modeCode"
        },
        {
          "op": "map",
          "from": "modeCode",
          "table": "ce",
          "to": "ce",
          "default": -1
        },
        {
          "op": "map",
          "from": "modeCode",
          "table": "rb",
          "to": "rb",
          "default": -1
        },
        {
          "op": "take",
          "len": 1,
          "to": "generationCode"
        },
        {
          "op": "map",
          "from": "generationCode",
          "table": "generation",
          "to": "generation",
          "default": -1
        },
        {
          "op": "tpl",
          "template": "{{die}}:{{cellLevel}}:{{densityCode}}:{{generationCode}}",
          "to": "singleDieProfileKey"
        },
        {
          "op": "map",
          "from": "singleDieProfileKey",
          "table": "singleDieProfile",
          "to": "singleDieProcessNode"
        },
        {
          "op": "tpl",
          "template": "{{classificationCode}}:{{densityCode}}:{{generationCode}}",
          "to": "packageProfileKey"
        },
        {
          "op": "map",
          "from": "packageProfileKey",
          "table": "packageProfile",
          "to": "packageProcessNode"
        },
        {
          "op": "fallback",
          "primary": "singleDieProcessNode",
          "secondary": "packageProcessNode",
          "to": "processNode"
        },
        {
          "op": "map",
          "from": "processNode",
          "table": "nand.die_profile",
          "to": "processObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "take",
          "len": 1,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package",
          "default": "Unknown"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "lead_free",
          "to": "lead_free",
          "default": false
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "halogen_free",
          "to": "halogen_free",
          "default": false
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "cu",
          "to": "cu",
          "default": false
        },
        {
          "op": "take",
          "len": 1,
          "to": "opTempCode"
        },
        {
          "op": "map",
          "from": "opTempCode",
          "table": "operation_temperature",
          "to": "operation_temperature",
          "default": "Unknown"
        },
        {
          "op": "take",
          "len": 1,
          "to": "badBlockCode"
        },
        {
          "op": "map",
          "from": "badBlockCode",
          "table": "bad_block",
          "to": "bad_block",
          "default": "Unknown"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "samsung",
        "device.chipKind": "raw_nand",
        "fields": {
          "toggle": {
            "$var": "toggleVer"
          },
          "lead_free": {
            "$var": "lead_free"
          },
          "halogen_free": {
            "$var": "halogen_free"
          },
          "cu": {
            "$var": "cu"
          },
          "operation_temperature": {
            "$var": "operation_temperature"
          },
          "bad_block": {
            "$var": "bad_block"
          }
        },
        "fields.cell_level": {
          "$var": "cellLevel"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.device_width": {
          "$var": "deviceWidth"
        },
        "fields.voltage": {
          "$var": "voltage"
        },
        "fields.generation_info": {
          "$var": "generation"
        },
        "fields.layer_count": {
          "$path": "processObj.layer_count"
        },
        "fields.die_codename": {
          "$var": "processNode"
        },
        "fields.package": {
          "$var": "package"
        },
        "fields.die_count": {
          "$var": "die"
        },
        "fields.ce_count": {
          "$var": "ce"
        },
        "fields.rb_count": {
          "$var": "rb"
        },
        "meta.ruleId": "vendor.samsung.token.v1"
      }
    }
  }
