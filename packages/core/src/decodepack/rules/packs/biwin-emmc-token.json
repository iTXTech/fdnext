[
  {
    "id": "vendor.biwin.emmc.v1",
    "priority": 1001,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|",
          "-"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^BWC(?:MAB811G|MMQ511G|TAK611G|TARJ11X|TAKC11X|TAKL11X|TAKL21X|TAKL41X)(?:04G|08G|16G|32G|64G|128G|256G|512G)$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "BWC"
      ],
      "tables": {
        "reference": {
          "biwin_official_emmc_order_table": {
            "status": "external_table_confirmed",
            "source": "BIWIN eMMC 5.1 order information"
          },
          "biwin_emmc51_pdf_package_check": {
            "status": "external_table_confirmed",
            "source": "BIWIN eMMC 5.1 specifications PDF"
          }
        },
        "configCode": [
          "MAB811G",
          "MMQ511G",
          "TAK611G",
          "TARJ11X",
          "TAKC11X",
          "TAKL11X",
          "TAKL21X",
          "TAKL41X"
        ],
        "densityCode": [
          "04G",
          "08G",
          "16G",
          "32G",
          "64G",
          "128G",
          "256G",
          "512G"
        ],
        "density": {
          "04G": 32768,
          "08G": 65536,
          "16G": 131072,
          "32G": 262144,
          "64G": 524288,
          "128G": 1048576,
          "256G": 2097152,
          "512G": 4194304
        },
        "package": {
          "04G": "FBGA-153, 11.50x13.00",
          "08G": "FBGA-153, 9.00x11.00",
          "16G": "FBGA-153, 11.50x13.00",
          "32G": "FBGA-153, 11.50x13.00",
          "64G": "FBGA-153, 11.50x13.00",
          "128G": "FBGA-153, 11.50x13.00",
          "256G": "FBGA-153, 11.50x13.00",
          "512G": "FBGA-153, 11.50x13.00"
        }
      },
      "steps": [
        {
          "op": "takeLongest",
          "table": "configCode",
          "to": "configCode",
          "default": ""
        },
        {
          "op": "takeLongest",
          "table": "densityCode",
          "to": "densityCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "package",
          "to": "package",
          "default": "FBGA153"
        },
        {
          "op": "set",
          "to": "extra",
          "value": {
            "product_class": "Consumer",
            "storage_interface": "eMMC 5.1",
            "nand_technology": "3D TLC",
            "interface_type": "HS400",
            "config_code": {
              "$var": "configCode"
            }
          }
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "biwin",
        "device.chipKind": "managed_nand",
        "device.productType": "emmc",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.cell_level": 3,
        "fields.package": {
          "$var": "package"
        },
        "meta.ruleId": "vendor.biwin.emmc.v1"
      }
    }
  }
]
