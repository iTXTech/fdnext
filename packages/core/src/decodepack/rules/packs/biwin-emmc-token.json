        "fields": { "$var": "extra" },
        "fields.density": { "$var": "density" },
        "fields.storage_interface": "eMMC 5.1",
        "fields.cell_level": { "$path": "configObj.cell_level" },
        "fields.package": { "$path": "configObj.package" },
        "meta.ruleId": "vendor.biwin.emmc.bwefm.v1",
        "meta.fieldProfile": "managed_nand",
        "meta.capabilities": ["part.decode", "part.search"]
