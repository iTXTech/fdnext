        { "op": "takeLongest", "table": "densityCode", "to": "densityCode", "default": "" },
        { "op": "take", "len": 4, "to": "configCode" },
        { "op": "map", "from": "densityCode", "table": "density", "to": "density", "default": 0 },
        { "op": "map", "from": "gradeCode", "table": "grade", "to": "extra", "default": {} },
        { "op": "map", "from": "configCode", "table": "configObj", "to": "configObj", "default": {} },
        { "op": "tpl", "template": "{{densityCode}}:{{configCode}}", "to": "densityConfigKey" },
        { "op": "map", "from": "densityConfigKey", "table": "densityConfigObj", "to": "densityConfigObj", "default": {} },
        { "op": "merge", "into": "configObj", "from": "densityConfigObj" },
        { "op": "merge", "into": "extra", "from": "configObj" },
        { "op": "omit", "from": "extra", "keys": ["cell_level", "package"] }
