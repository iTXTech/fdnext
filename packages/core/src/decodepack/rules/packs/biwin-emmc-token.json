          "N9RE": { "nand_technology": "MLC", "cell_level": 2, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N2RE": { "nand_technology": "MLC", "cell_level": 2, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N7RJ": { "nand_technology": "3D TLC", "cell_level": 3, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N729": { "nand_technology": "3D TLC", "cell_level": 3, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N8RC": { "nand_technology": "MLC", "cell_level": 2, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N2RJ": { "nand_technology": "3D TLC", "cell_level": 3, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N223": { "nand_technology": "3D TLC", "cell_level": 3, "package": "FBGA-153, 11.50x13.00x1.10" },
          "N929": { "package": "FBGA-153, 11.50x13.00x1.10" }
        },
        "densityConfigObj": {
          "008G:N929": { "nand_technology": "Win-pSLC (TLC NAND)", "cell_level": 1, "special_option": "pSLC Mode" },
          "016G:N929": { "nand_technology": "Win-pSLC (TLC NAND)", "cell_level": 1, "special_option": "pSLC Mode" },
          "064G:N929": { "nand_technology": "3D TLC", "cell_level": 3 },
