        },
        {
          "op": "merge",
          "into": "extra",
          "from": "densityGradeObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "functionalityObj"
        },
        {
          "op": "mergeIf",
          "if": "hasDieProfile",
          "into": "extra",
          "from": "dieProfileFieldObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "spectek",
        "device.chipKind": "raw_nand",
        "fields": {
