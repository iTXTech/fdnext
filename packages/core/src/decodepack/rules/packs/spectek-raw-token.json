          "len": 1,
          "to": "packageCode"
        },
        {
          "op": "map",
          "from": "packageCode",
          "table": "package",
          "to": "package"
        },
        {
          "op": "take",
          "len": 1,
          "to": "functionalityCode"
        },
        {
          "op": "map",
          "from": "functionalityCode",
