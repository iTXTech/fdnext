        },
        {
          "op": "map",
          "from": "stackKey",
          "table": "stackObj",
          "to": "stackObj",
          "default": {}
        },
        {
          "op": "map",
          "from": "speedCode",
          "table": "speedObj",
          "to": "speedObj"
        },
        {
          "op": "set",
