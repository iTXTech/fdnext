      "steps": [
        {
          "op": "takeRegex",
          "pattern": "^(?<densityCode>AG|64)ESM(?<stackCode>[0-9A-Z])W-?(?<speedCode>N6|N8)L$",
          "groups": {
            "densityCode": "densityCode",
            "stackCode": "stackCode",
            "speedCode": "speedCode"
          }
        },
        {
          "op": "tpl",
