[
  {
    "id": "vendor.micron.ssd.2100ai-at.v1",
    "priority": 1008,
    "normalize": [
      "trim",
      "uppercase",
      {
        "remove": [
          " ",
          ",",
          "&",
          ".",
          "|"
        ]
      }
    ],
    "match": {
      "kind": "regex",
      "value": "^MTFDH(?:BL(?:064|128|256|512)|BM1T0|BK(?:128|256|512|1T0))T(?:DP|DQ)-?(?:A|1)AT1(?:2)(?:AI|AT)YY(?:ES)?$"
    },
    "tokenDecoder": {
      "stripPrefixes": [
        "MTFDH"
      ],
      "tables": {
        "density": {
          "128": 1048576,
          "256": 2097152,
          "512": 4194304,
          "064": 524288,
          "1T0": 8388608
        },
        "packageObj": {
          "BL:064": {
            "package": "BGA-291, 16x20x1.2, type 1620"
          },
          "BL:128": {
            "package": "BGA-291, 16x20x1.2, type 1620"
          },
          "BL:256": {
            "package": "BGA-291, 16x20x1.2, type 1620"
          },
          "BL:512": {
            "package": "BGA-291, 16x20x1.2, type 1620"
          },
          "BM:1T0": {
            "package": "BGA-291, 16x20x1.6, type 1620"
          },
          "BK:128": {
            "package": "M.2-2230, 22x30x2.0, M-key"
          },
          "BK:256": {
            "package": "M.2-2230, 22x30x2.0, M-key"
          },
          "BK:512": {
            "package": "M.2-2230, 22x30x2.0, M-key"
          },
          "BK:1T0": {
            "package": "M.2-2230, 22x30x2.4, M-key"
          }
        },
        "nandTypeObj": {
