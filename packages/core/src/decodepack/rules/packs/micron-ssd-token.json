            "cell_level": "TLC",
            "nand_technology": "Micron 3D TLC NAND Flash"
          }
        },
        "productFamilyObj": {
          "DP": {
            "product_family": "Micron 2100AI SSD",
            "product_version": "NVMe 1.3c",
            "storage_interface": "PCIe Gen3 x4"
          },
          "DQ": {
            "product_family": "Micron 2100AT SSD",
            "product_version": "NVMe 1.3c",
            "storage_interface": "PCIe Gen3 x4"
          }
        },
        "bomObj": {
          "1": {
            "generation_info": "1st Generation"
          },
          "A": {
            "product_class": "Engineering samples"
          }
        },
        "componentObj": {
          "AT": {
            "nand_component": "512Gb TLC x8 3.3V (3D)",
            "component_density": "512Gb",
            "component_width": "x8",
            "component_voltage": "3.3V"
          }
        },
        "sectorSize": {
          "1": 512
        },
        "firmwareObj": {
          "2": {
            "special_option": "Self-encrypting drive (SED)"
          }
        },
        "temperatureObj": {
          "AI": {
            "operation_temperature": "Automotive support, Industrial (-40°C to +95°C)"
          },
          "AT": {
            "operation_temperature": "Automotive (-40°C to +105°C)"
          }
        },
        "productionStatusObj": {
          "ES": {
            "prod_status": "Engineering samples"
          }
        }
      },
      "steps": [
        {
          "op": "take",
          "len": 2,
          "to": "formCode"
        },
        {
          "op": "take",
          "len": 3,
          "to": "densityCode"
        },
        {
          "op": "map",
          "from": "densityCode",
          "table": "density",
          "to": "density",
          "default": 0
        },
        {
          "op": "tpl",
          "template": "{{formCode}}:{{densityCode}}",
          "to": "packageKey"
        },
        {
          "op": "map",
          "from": "packageKey",
          "table": "packageObj",
          "to": "packageObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "nandTypeCode"
        },
        {
          "op": "map",
          "from": "nandTypeCode",
          "table": "nandTypeObj",
          "to": "nandTypeObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "productFamilyCode"
        },
        {
          "op": "map",
          "from": "productFamilyCode",
          "table": "productFamilyObj",
          "to": "productFamilyObj",
          "default": {}
        },
        {
          "op": "stripIfPrefix",
          "prefix": "-"
        },
        {
          "op": "take",
          "len": 1,
          "to": "bomCode"
        },
        {
          "op": "map",
          "from": "bomCode",
          "table": "bomObj",
          "to": "bomObj",
