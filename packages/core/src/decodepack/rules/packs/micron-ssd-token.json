        },
        {
          "op": "take",
          "len": 2,
          "to": "componentCode"
        },
        {
          "op": "map",
          "from": "componentCode",
          "table": "componentObj",
          "to": "componentObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 1,
          "to": "sectorCode"
        },
        {
          "op": "map",
          "from": "sectorCode",
          "table": "sectorSize",
          "to": "sectorSize",
          "default": 0
        },
        {
          "op": "take",
          "len": 1,
          "to": "firmwareCode"
        },
        {
          "op": "map",
          "from": "firmwareCode",
          "table": "firmwareObj",
          "to": "firmwareObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "temperatureCode"
        },
        {
          "op": "map",
          "from": "temperatureCode",
          "table": "temperatureObj",
          "to": "temperatureObj",
          "default": {}
        },
        {
          "op": "take",
          "len": 2,
          "to": "customerCode"
        },
        {
          "op": "takeRegex",
          "pattern": "^ES",
          "to": "productionStatusCode",
          "default": ""
        },
        {
          "op": "map",
          "from": "productionStatusCode",
          "table": "productionStatusObj",
          "to": "productionStatusObj",
          "default": {}
        },
        {
          "op": "set",
          "to": "extra",
          "value": {}
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productFamilyObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "nandTypeObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "packageObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "bomObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "componentObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "firmwareObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "temperatureObj"
        },
        {
          "op": "merge",
          "into": "extra",
          "from": "productionStatusObj"
        }
      ],
      "assign": {
        "device.partNumber": {
          "$var": "partNumber"
        },
        "device.domain": "memory",
        "device.vendor": "micron",
        "device.chipKind": "managed_nand",
        "device.productType": "nvme",
        "fields": {
          "$var": "extra"
        },
        "fields.density": {
          "$var": "density"
        },
        "fields.sector_size": {
          "$var": "sectorSize"
        },
        "meta.ruleId": "vendor.micron.ssd.2100ai-at.v1"
      }
    }
  }
]
