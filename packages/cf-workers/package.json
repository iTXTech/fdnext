{
  "name": "@itxtech/fdnext-cf-workers",
  "version": "3.2.0",
  "homepage": "https://github.com/iTXTech/fdnext/tree/master/packages/cf-workers",
  "type": "module",
  "dependencies": {
    "@itxtech/fdnext-core": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b --emitDeclarationOnly && tsdown",
    "dev": "pnpm dlx wrangler dev --config wrangler.jsonc",
    "deploy": "pnpm dlx wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "pnpm dlx wrangler deploy --dry-run --outdir ../../.wrangler-bundle/cf-workers --config wrangler.jsonc",
    "typecheck": "tsc -b --pretty false --emitDeclarationOnly"
  }
}
