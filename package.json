{
  "name": "fdnext",
  "private": true,
  "type": "module",
  "version": "3.2.0",
  "description": "Memory chip parsing and resource toolkit",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test:source": "pnpm -r --parallel --filter='!@itxtech/fdnext-contract-test' --if-present test",
    "test:package": "pnpm -C packages/contract-test test",
    "test": "node scripts/run-pnpm-parallel.mjs test:source test:package",
    "check:decodepack": "pnpm cli decodepack check",
    "check:config": "tsc -p tsconfig.json --noEmit --pretty false",
    "check:static": "pnpm typecheck && pnpm check:decodepack",
    "lint": "pnpm check:static",
    "check:rules": "pnpm -C packages/core test:decodepack",
    "check:package": "pnpm build && pnpm -C packages/contract-test test:prepared",
    "check": "node scripts/run-pnpm-parallel.mjs check:static check:rules",
    "check:pr": "node scripts/run-pnpm-parallel.mjs check:config check:decodepack test:source check:package",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json --noEmit --pretty false",
    "server:dev": "pnpm -C packages/server dev",
    "server:start": "pnpm -C packages/server start",
    "fdserver:dev": "pnpm -C packages/fd-server dev",
    "fdserver:worker:dev": "pnpm -C packages/fd-server run worker:dev",
    "fdserver:worker:deploy": "pnpm -C packages/fd-server run worker:deploy",
    "fdserver:worker:deploy:dry-run": "pnpm -C packages/fd-server run worker:deploy:dry-run",
    "cf-workers:build": "pnpm -C packages/core build && pnpm -C packages/cf-workers build",
    "cf-workers:dev": "pnpm -C packages/cf-workers run dev",
    "cf-workers:deploy": "pnpm -C packages/cf-workers run deploy",
    "cf-workers:deploy:dry-run": "pnpm -C packages/cf-workers run deploy:dry-run",
    "cli": "pnpm -s tsx ./packages/core/src/cli/index.ts",
    "fdbgen:build": "pnpm -C packages/fdbgen build",
    "fdbgen:generate": "pnpm -s tsx ./packages/fdbgen/src/cli.ts build",
    "fdbgen:audit": "pnpm -s tsx ./packages/fdbgen/src/cli.ts audit --file packages/core/resources/fdb.json",
    "fdbgen:audit-extra": "pnpm -s tsx ./packages/fdbgen/src/cli.ts audit-extra",
    "fdbgen:audit:trace": "pnpm -s tsx ./packages/fdbgen/src/cli.ts audit --input ../fdfdb --version 82 --trace-sources",
    "fdbgen:crawl-mdb": "pnpm -s tsx ./packages/fdbgen/src/cli.ts crawl-mdb",
    "contract:check": "pnpm -C packages/contract-test check"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "ajv": "^8.20.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  }
}
